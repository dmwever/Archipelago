;Joan of Arc scenario 2 Player 2
;Burgundy

(load "scenario market")
(load "scenario difficulty DE")
(load "scenario upgrades DE")

(defconst cathedral 599)

(defconst gl-available-food-amount 10)
(defconst temporary-goal 11)

(defrule
	(true)
=>
	(up-get-fact food-amount 0 gl-available-food-amount)
	(up-get-fact escrow-amount food temporary-goal)
	(up-modify-goal gl-available-food-amount g:- temporary-goal)
)

;resigning
(defrule
	(not (player-in-game 3))
	(not (player-in-game 7))
=>
	(resign)
	(disable-self)
)

(defrule
	(true)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-town-size 25)
    (set-strategic-number sn-camp-max-distance 30)
    (set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
    (set-strategic-number sn-special-attack-type1 cathedral) ;Target Cathedral
	(set-strategic-number sn-wall-targeting-mode 1)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders 15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(set-strategic-number sn-cap-civilian-gatherers 100)
	(set-strategic-number sn-food-gatherer-percentage  55)
	(set-strategic-number sn-gold-gatherer-percentage  0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
	(set-strategic-number sn-wood-gatherer-percentage  45)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-percent-attack-soldiers 75)
	(disable-self)
)

(defrule
	(game-time greater-than 1200)
=>
	(set-strategic-number sn-task-ungrouped-soldiers 1)
	(set-strategic-number sn-number-explore-groups 2)
	(attack-now)
	(enable-timer 1 800)
	(disable-self)
)

(defrule
	(defend-soldier-count >= 6)
	(timer-triggered 1)
=>
	(attack-now)
	(disable-timer 1)
	(enable-timer 1 600)
)

(defrule
	(building-type-count mining-camp > 0)
=>
	(set-strategic-number sn-food-gatherer-percentage  55)
	(set-strategic-number sn-gold-gatherer-percentage  15)
	(set-strategic-number sn-stone-gatherer-percentage 0)
	(set-strategic-number sn-wood-gatherer-percentage  30)
	(disable-self)
)

; ================= CASTLE AGE

(defrule
	(unit-type-count-total villager > 16)
	(current-age == feudal-age)
	(difficulty <= moderate)
=>
	(set-goal 16 98)
	(disable-self)
)

(defrule
	(goal 16 98)
	(wood-amount greater-than 600)
	(can-sell-commodity wood)
=>
	(chat-local-to-self "selling wood for castle gold")
	(sell-commodity wood)
)

(defrule
	(goal 16 98)
	(stone-amount greater-than 500)
	(commodity-selling-price stone greater-than 50)
	(can-sell-commodity stone)
=>
	(chat-local-to-self "selling stone for castle gold")
	(sell-commodity stone)
)

(defrule
	(goal 16 98)
	(food-amount greater-or-equal 1100)
	(can-sell-commodity food)
=>
	(chat-local-to-self "selling food for castle gold")
	(sell-commodity food)
)

;getting needed food
(defrule
	(goal 16 98)
	(gold-amount greater-or-equal 1000)
	(commodity-buying-price food less-than 200)
	(can-buy-commodity food)
=>
	(chat-local-to-self "buying castle food")
	(buy-commodity food)
)

; advance to castle age if possible.
(defrule
	(goal 16 98)
	(can-research-with-escrow castle-age)
=>
	(release-escrow wood)
	(release-escrow food)
	(release-escrow gold)
	(release-escrow stone)
	(set-strategic-number sn-food-gatherer-percentage  55)
	(set-strategic-number sn-gold-gatherer-percentage  20)
	(set-strategic-number sn-stone-gatherer-percentage 5)
	(set-strategic-number sn-wood-gatherer-percentage  20)
	(research castle-age)
	(chat-local-to-self "rising to castle")
	(set-goal 16 0)
)


;maintain housing
(defrule
	(housing-headroom less-than 4)
	(population-headroom greater-than 0)
	(can-build house)
=>
	(build house)
	(chat-local-to-self "house")
)

;maintain a town center
(defrule
	(building-type-count town-center less-than 1)
	(can-build town-center)
=>
	(build town-center)
	(chat-local-to-self "Town Center")
)

;villager count
(defrule
	(difficulty == easy)
	(unit-type-count-total villager less-than 20)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

(defrule
	(difficulty == moderate)
	(unit-type-count-total villager less-than 25)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

(defrule
	(difficulty == hard)
	(unit-type-count-total villager less-than 30)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

;villager count castle age
(defrule
	(difficulty == easy)
	(unit-type-count-total villager less-than 25)
	(current-age == castle-age)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

(defrule
	(difficulty == moderate)
	(unit-type-count-total villager less-than 30)
	(current-age == castle-age)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

(defrule
	(difficulty == hard)
	(unit-type-count-total villager less-than 35)
	(current-age == castle-age)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

;maintain needed buildings

(defrule
	(building-type-count-total mill less-than 1)
	(can-build mill)
=>
	(build mill)
	(chat-local-to-self "mill")
)

(defrule
	(building-type-count-total market less-than 1)
	(can-build market)
=>
	(build market)
	(chat-local-to-self "market")
)

(defrule
	(building-type-count-total barracks less-than 2)
	(can-build barracks)
=>
	(build barracks)
	(chat-local-to-self "barracks")
)

(defrule
	(building-type-count-total blacksmith less-than 1)
	(can-build blacksmith)
=>
	(build blacksmith)
	(chat-local-to-self "blacksmith")
)

(defrule
	(difficulty < easy)
    (building-type-count-total monastery less-than 1)
    (can-build monastery)
=>
    (build monastery)
	(chat-local-to-self "monastery")
)

(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 10)
	(dropsite-min-distance wood > 3)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(resource-found gold)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance gold > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "gold place")
)

(defrule
	(resource-found stone)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance stone > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "rock place")
)

;construct farms if food gets short.
(defrule
	(building-type-count-total farm less-than 18)
	(idle-farm-count < 1)
	(can-build farm)
=>
	(build farm)
	(chat-local-to-self "farm")
)


; TROOPS
; Feudal Age

(defrule
	(food-amount > 150)
	(unit-type-count-total militiaman-line less-than 6)
	(current-age == feudal-age)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "infantry")
)

(defrule
	(up-compare-goal gl-available-food-amount > 150)
	(unit-type-count-total spearman-line less-than 8)
	(current-age == feudal-age)
	(can-train spearman-line)
=>
	(train spearman-line)
	(chat-local-to-self "stickman")
)

; Castle Age

(defrule
	(up-compare-goal gl-available-food-amount > 75)
	(current-age == castle-age)
	(difficulty == easy)
	(unit-type-count-total militiaman-line less-than 8)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "infantry")
)

(defrule
	(up-compare-goal gl-available-food-amount > 75)
	(current-age == castle-age)
	(difficulty == moderate)
	(unit-type-count-total militiaman-line less-than 12)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "infantry")
)

(defrule
	(up-compare-goal gl-available-food-amount > 75)
	(current-age == castle-age)
	(difficulty == hard)
	(unit-type-count-total militiaman-line less-than 17)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "infantry")
)

(defrule
	(up-compare-goal gl-available-food-amount > 75)
	(current-age == castle-age)
	(difficulty == easy)
	(unit-type-count-total spearman-line less-than 12)
	(can-train spearman-line)
=>
	(train spearman-line)
	(chat-local-to-self "stickman")
)

(defrule
	(up-compare-goal gl-available-food-amount > 75)
	(current-age == castle-age)
	(difficulty == moderate)
	(unit-type-count-total spearman-line less-than 17)
	(can-train spearman-line)
=>
	(train spearman-line)
	(chat-local-to-self "stickman")
)

(defrule
	(up-compare-goal gl-available-food-amount > 75)
	(current-age == castle-age)
	(difficulty == hard)
	(unit-type-count-total spearman-line less-than 21)
	(can-train spearman-line)
=>
	(train spearman-line)
	(chat-local-to-self "stickman")
)

;tribute rules
(defrule
	(not (goal 16 98))
	(wood-amount greater-than 900)
=>
	(tribute-to-player 3 wood 100)
)

(defrule
	(not (goal 16 98))
	(food-amount greater-than 900)
=>
	(tribute-to-player 3 food 100)
)

(defrule
	(not (goal 16 98))
	(stone-amount greater-than 200)
=>
	(tribute-to-player 3 stone 100)
)

(defrule
	(not (goal 16 98))
	(gold-amount greater-than 400)
=>
	(tribute-to-player 3 gold 100)
)
