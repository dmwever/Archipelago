; Mongols scenario 4 player 3
; Russians (Slavs)

(load "scenario market")
(load "scenario upgrades DE")
(load "scenario difficulty DE")
(load "scenario resign FE")

;RELEASE ESCROW
(defrule
	(true)
=>	
	(enable-timer 9 900) ; Release escrow
	(disable-self)
)

(defrule ; don't hold on to resources
	(timer-triggered 9)
=>
	(release-escrow wood)
	(release-escrow food)
	(release-escrow gold)
	(release-escrow stone)
	(disable-timer 9)
	(enable-timer 9 600)
)

(defrule
	(building-type-count castle < 1)
	(military-population < 4)
=>
	(set-goal 1 19)
	(disable-self)
)

(defrule
	(true)
=>
        (set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-town-size 25)
        (set-strategic-number sn-camp-max-distance 30)
        (set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(set-strategic-number sn-percent-attack-soldiers 80)
	(set-strategic-number sn-number-explore-groups 2)
	(set-strategic-number sn-attack-intelligence 1)
	(set-strategic-number sn-wall-targeting-mode 1)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders  15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-gatherers 100)
	(set-strategic-number sn-food-gatherer-percentage  35)
	(set-strategic-number sn-gold-gatherer-percentage  35)
	(set-strategic-number sn-stone-gatherer-percentage 5)
	(set-strategic-number sn-wood-gatherer-percentage  25)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(enable-timer 1 700)
	(disable-self)
)

(defrule
	(timer-triggered 1)
	(defend-soldier-count >= 20)
=>
	(attack-now)
	(disable-timer 1)
	(enable-timer 1 700)
)

;maintain housing
(defrule
	(housing-headroom less-than 4)
	(population-headroom greater-than 0)
	(can-build house)
=>
	(build house)
	(chat-local-to-self "house")
)


;maintain a town center
(defrule
	(building-type-count town-center less-than 1)
	(can-build town-center)
=>
	(build town-center)
)

;villager count
(defrule
	(unit-type-count-total villager less-than 20)
	(can-train villager)
=>
	(train villager)
)

;maintain needed buildings
(defrule
	(building-type-count-total market less-than 1)
	(can-build market)
=>
	(build market)
)

(defrule
	(building-type-count-total mill less-than 1)
	(can-build mill)
=>
	(build mill)
)

(defrule
	(building-type-count-total barracks less-than 3)
	(can-build barracks)
=>
	(build barracks)
)

(defrule
	(building-type-count-total blacksmith less-than 1)
	(can-build blacksmith)
=>
	(build blacksmith)
)

(defrule
	(building-type-count-total stable less-than 2)
	(can-build stable)
=>
	(build stable)
)

(defrule
	(building-type-count-total university less-than 1)
	(can-build university)
=>
	(build university)
)

(defrule
	(building-type-count-total castle less-than 1)
	(can-build castle)
=>
	(build castle)
)

(defrule
	(building-type-count-total siege-workshop less-than 2)
	(can-build siege-workshop)
=>
	(build siege-workshop)
)

(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 5)
	(dropsite-min-distance wood > 5)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(resource-found gold)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance gold > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "gold place")
)

(defrule
	(resource-found stone)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance stone > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "rock place")
)

;construct farms if food gets short.
(defrule
	(building-type-count-total farm less-than 3)
	(can-build farm)
=>
	(build farm)
)

(defrule
	(food-amount less-than 300)
	(idle-farm-count <= 1)
	(building-type-count-total farm less-than 6)
	(can-build farm)
=>
	(build farm)
)

(defrule
	(food-amount less-than 100)
	(building-type-count-total farm less-than 10)
	(can-build farm)
=>
	(build farm)
)

;units
(defrule
	(unit-type-count-total militiaman-line less-than 30)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "swordage")
)

(defrule
	(unit-type-count-total knight-line less-than 6)
	(can-train knight-line)
=>
	(train knight-line)
	(chat-local-to-self "horseage")
)

(defrule
	(not(town-under-attack))
	(unit-type-count-total battering-ram-line less-than 4)
	(can-train battering-ram-line)
=>
	(train battering-ram-line)
	(chat-local-to-self "rammage")
)

(defrule
	(not (difficulty == normal))
	(unit-type-count-total my-unique-unit-line less-than 8)
	(can-train my-unique-unit-line)
=>
	(train my-unique-unit-line)
	(chat-local-to-self "berserker, no I mean huskarl, no I mean Boyar")
)

(defrule
	(difficulty == normal)
	(unit-type-count-total my-unique-unit-line less-than 3)
	(can-train my-unique-unit-line)
=>
	(train my-unique-unit-line)
	(chat-local-to-self "berserker, no I mean huskarl, no I mean Boyar")
)

