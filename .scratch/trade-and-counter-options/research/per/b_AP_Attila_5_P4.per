	(difficulty == hard)
	(game-time greater-than 100)
	(unit-type-count-total huskarl-line less-than 20)
	(can-train huskarl-line)
=>
	(train huskarl)
	(chat-local-to-self "huskarl")
)

(defrule
	(difficulty == easy)
	(game-time greater-than 100)
	(unit-type-count-total trebuchet-set less-than 2)
	(can-train trebuchet)
=>
	(train trebuchet)
	(chat-local-to-self " trebuchet ")
)

(defrule
	(difficulty == moderate)
	(game-time greater-than 100)
	(unit-type-count-total trebuchet-set less-than 4)
	(can-train trebuchet)
=>
	(train trebuchet)
	(chat-local-to-self " trebuchet ")
)

(defrule
	(difficulty == hard)
	(game-time greater-than 100)
