;Attila scenario 4 Player 5
;Rome

(load "scenario difficulty DE")
(load "scenario resign FE")

(defrule
	(event-detected trigger 37) ; attack
=>
	(enable-timer 1 150)
	(enable-timer 2 300)
	(disable-self)
)

(defrule
	(timer-triggered 1)
	(military-population < 3)
=>
	(set-goal 1 19)
	(disable-self)
)
	
; GROUPS

(defrule
	(true)
=>
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 0)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-number-explore-groups 2)
	(set-strategic-number sn-do-not-scale-for-difficulty-level 1)
	(set-strategic-number sn-wall-targeting-mode 1)
	(disable-self)
)

(defrule
	(timer-triggered 1)
=>
	(attack-now)
	(chat-local-to-self "attack")
	(disable-timer 1)
	(enable-timer 1 5)
)

(defrule
	(timer-triggered 2)
=>
	(set-strategic-number sn-number-explore-groups 0)
	(disable-timer 2)
	(disable-self)
)


