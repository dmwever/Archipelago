;Joan of Arc scenario 4 p3
;Chalon - green
;Knights, siege and naval

(load "scenario market")
(load "scenario upgrades DE")
(load "scenario difficulty DE")
(load "scenario resign")

(defrule ; TC has been destroyed, pacify player
	(event-detected trigger 26)
=>
	(set-strategic-number sn-food-gatherer-percentage 60)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
	(set-strategic-number sn-wood-gatherer-percentage 40)
	(set-strategic-number sn-maximum-town-size 10)
	(set-goal 1 20)
	(set-goal 2 10)
	(disable-self)
)

(defrule
	(goal 1 20)
=>
	(delete-building barracks)
	(delete-building archery-range)
	(delete-building stable)
	(delete-building siege-workshop)
	(delete-building castle)
	(delete-building watch-tower)
	(delete-building guard-tower)
	(delete-building keep)
	(delete-building bombard-tower)
	(delete-building mining-camp)
)

(defrule
	(goal 1 20)
=>
	(delete-unit militiaman)
	(delete-unit man-at-arms)
	(delete-unit long-swordsman)
	(delete-unit two-handed-swordsman)
	(delete-unit champion)
	(delete-unit petard)
	(delete-unit spearman)
	(delete-unit pikeman)
	(delete-unit halberdier)
)

(defrule
	(goal 1 20)
=>
	(delete-unit archer)
	(delete-unit crossbowman)
	(delete-unit arbalest)
	(delete-unit skirmisher)
	(delete-unit elite-skirmisher)
	(delete-unit imperial-skirmisher)
	(delete-unit scout-cavalry)
	(delete-unit light-cavalry)
	(delete-unit hussar)
	(delete-unit knight)
)

(defrule
	(goal 1 20)
=>
	(delete-unit cavalier)
	(delete-unit paladin)
	(delete-unit my-unique-unit)
	(delete-unit galley)
	(delete-unit war-galley)
	(delete-unit galleon)
	(delete-unit cannon-galleon)
	(delete-unit fire-ship)
	(delete-unit fast-fire-ship)
	(delete-unit battering-ram)
	(delete-unit capped-ram)
)

(defrule
	(goal 1 20)
=>
	(delete-unit siege-ram)
	(delete-unit mangonel)
	(delete-unit onager)
	(delete-unit siege-onager)
	(delete-unit scorpion)
	(delete-unit heavy-scorpion)
	(delete-unit transport-ship)
	(delete-unit hand-cannoneer)
	(delete-unit bombard-cannon)
	(delete-unit demolition-ship)
	(delete-unit heavy-demolition-ship)
)

(defrule
	(goal 1 20)
	(military-population == 0)
	(building-type-count watch-tower-line == 0)
	(building-type-count bombard-tower == 0)
	(building-type-count castle == 0)
=>
	(set-goal 1 1)
	(disable-self)
)

; START

(defrule
	(true)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-town-size 25)
    (set-strategic-number sn-camp-max-distance 30)
    (set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(set-strategic-number sn-wall-targeting-mode 1)
	(set-goal 2 1)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-food-gatherer-percentage 40)
	(set-strategic-number sn-gold-gatherer-percentage 30)
	(set-strategic-number sn-stone-gatherer-percentage 5)
	(set-strategic-number sn-wood-gatherer-percentage 25)
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders 15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(enable-timer 4 3600)
	(disable-self)
)

; in case of long game, break glass
(defrule
	(timer-triggered 4)
	(goal 2 1)
=>
	(chat-local-to-self "I think I need some resources")
	(cc-add-resource food 400)
	(cc-add-resource wood 400)
	(cc-add-resource gold 400)
	(disable-timer 4)
	(enable-timer 4 2700)
)

; COMBAT

(defrule
	(true)
=>
	(set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-number-boat-explore-groups 1)
	(disable-self)
)

(defrule
    (cc-players-building-type-count 1 dock greater-than 0)
	(warboat-count > 1)
	(goal 2 1)
=>
	(set-strategic-number sn-percent-attack-boats 100%)
	(set-strategic-number sn-percent-attack-soldiers 0%)
	(attack-now)
	(chat-local-to-self "attacking with boats")
)

; Initial attack across river once Joan has TC
(defrule
	(difficulty == easy)
	(event-detected trigger 15)
	(goal 2 1)
=>
	(enable-timer 1 1240)
	(disable-self)
)

(defrule
	(difficulty == moderate)
	(event-detected trigger 15)
	(goal 2 1)
=>
	(set-strategic-number sn-cap-civilian-builders 3)
	(enable-timer 1 740)
	(disable-self)
)

(defrule
	(difficulty == hard)
	(event-detected trigger 15)
	(goal 2 1)
=>
	(set-strategic-number sn-cap-civilian-builders 5)
	(enable-timer 1 340)
	(disable-self)
)

(defrule
	(timer-triggered 9)
	(goal 2 1)
=>
	(set-strategic-number sn-percent-attack-boats 0%)
	(set-strategic-number sn-percent-attack-soldiers 65%)
	(attack-now)
	(chat-local-to-self "Joan has TC so charge")
	(disable-self)
)

 (defrule
	(game-time > 1260)
	(goal 2 1)
=>
	(set-strategic-number sn-percent-attack-soldiers 50)
	(set-strategic-number sn-percent-attack-boats 0)
	(attack-now)
	(enable-timer 6 300)
	(chat-local-to-self "attacking at 1260")
	(disable-self)
)

(defrule
	(timer-triggered 6)
	(defend-soldier-count > 10)
	(goal 2 1)
=>
	(set-strategic-number sn-percent-attack-soldiers 40)
	(set-strategic-number sn-percent-attack-boats 0)
	(attack-now)
	(disable-timer 6)
	(enable-timer 6 500)
	(chat-local-to-self "time to charge etc")
)

;BUILD & MAINTAIN BUILDINGS
(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 5)
	(dropsite-min-distance wood > 5)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(resource-found gold)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance gold > 7)
	(can-build mining-camp)
	(goal 2 1)
=>
	(build mining-camp)
	(chat-local-to-self "gold place")
)

(defrule
	(resource-found stone)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance stone > 7)
	(can-build mining-camp)
	(goal 2 1)
=>
	(build mining-camp)
	(chat-local-to-self "rock place")
)

(defrule
	(building-type-count-total market less-than 1)
	(can-build market)
=>
	(build market)
	(chat-local-to-self "market")
)

(defrule
	(building-type-count-total mill less-than 1)
	(can-build mill)
=>
	(build mill)
	(chat-local-to-self "mill")
)

(defrule
	(building-type-count-total barracks less-than 1)
	(can-build barracks)
	(goal 2 1)
=>
	(build barracks)
	(chat-local-to-self "barracks")
)

(defrule
	(building-type-count-total blacksmith less-than 1)
	(can-build blacksmith)
	(goal 2 1)
=>
	(build blacksmith)
	(chat-local-to-self "smith")
)

(defrule
	(building-type-count-total stable less-than 2)
	(can-build stable)
	(goal 2 1)
=>
	(build stable)
	(chat-local-to-self "stable")
)

(defrule
	(building-type-count-total dock less-than 1)
	(can-build dock)
	(goal 2 1)
=>
	(build dock)
	(chat-local-to-self "dock")
)

(defrule
	(building-type-count-total siege-workshop less-than 1)
	(can-build siege-workshop)
	(goal 2 1)
=>
	(build siege-workshop)
	(chat-local-to-self "siege")
)

(defrule
	(game-time greater-than 1200)
	(building-type-count-total university less-than 1)
	(can-build university)
	(goal 2 1)
=>
	(build university)
	(chat-local-to-self "university")
)


(defrule
	(building-type-count-total town-center < 1)
	(can-build town-center)
	(goal 2 10)
=>
	(build town-center)
	(chat-local-to-self "town center")
	(disable-self)
)

; villager count
(defrule
	(unit-type-count-total villager less-than 10)
	(can-train villager)
	(goal 2 10)
=>
	(train villager)
	(chat-local-to-self "civilian easy")
)

(defrule
	(difficulty == easy)
	(unit-type-count-total villager less-than 20)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "civilian easy")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total villager less-than 42)
	(can-train villager)
	(goal 2 1)
=>
	(train villager)
	(chat-local-to-self "civilian")
)

;maintain housing
(defrule
	(housing-headroom less-than 4)
	(population-headroom greater-than 0)
	(can-build house)
=>
	(build house)
	(chat-local-to-self "house")
)

;construct farms

(defrule
	(building-type-count-total farm less-than 20)
	(can-build farm)
	(idle-farm-count <= 1)
=>
	(build farm)
	(chat-local-to-self "farm")
)

;rise in age, if you can
(defrule
	(unit-type-count-total villager > 25)
	(current-age == castle-age)
	(goal 2 1)
=>
	(set-goal 16 99)
	(disable-self)
)

(defrule
(goal 16 99)
	(wood-amount greater-than 600)
	(can-sell-commodity wood)
=>
	(chat-local-to-self "selling wood for imperial gold")
	(sell-commodity wood)
)

(defrule
(goal 16 99)
	(stone-amount greater-than 500)
	(commodity-selling-price stone greater-than 50)
	(can-sell-commodity stone)
=>
	(chat-local-to-self "selling stone for imperial gold")
	(sell-commodity stone)
)

(defrule
(goal 16 99)
	(food-amount greater-or-equal 1100)
	(can-sell-commodity food)
=>
	(chat-local-to-self "selling food for imperial gold")
	(sell-commodity food)
)

;getting needed food
(defrule
(goal 16 99)
	(gold-amount greater-or-equal 1000)
	(commodity-buying-price food less-than 200)
	(can-buy-commodity food)
=>
	(chat-local-to-self "buying imperial food")
	(buy-commodity food)
)

; advance to imperial age if possible.
(defrule
	(goal 16 99)
	(can-research-with-escrow imperial-age)
	(goal 2 1)
=>
	(release-escrow wood)
	(release-escrow food)
	(release-escrow gold)
	(release-escrow stone)
	(research imperial-age)
	(chat-local-to-self "rising to imperial")
	(set-goal 16 0)
)

;Make an army

(defrule
	(unit-type-count-total knight-line less-than 12)
	(can-train knight-line)
	(goal 2 1)
=>
	(train knight-line)
	(chat-local-to-self "knight")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total knight-line less-than 20)
	(can-train knight-line)
	(goal 2 1)
=>
	(train knight-line)
	(chat-local-to-self "knight")
)

(defrule
	(not (town-under-attack))
	(unit-type-count-total battering-ram-line less-than 3)
	(can-train battering-ram-line)
	(goal 2 1)
=>
	(train battering-ram-line)
	(chat-local-to-self "battering-ram")
)

(defrule
	(difficulty <= moderate)
	(not (town-under-attack))
	(unit-type-count-total battering-ram-line less-than 5)
	(can-train battering-ram-line)
	(goal 2 1)
=>
	(train battering-ram-line)
	(chat-local-to-self "battering-ram")
)

(defrule
	(difficulty == easy)
	(unit-type-count-total scorpion-line less-than 3)
	(can-train scorpion-line)
	(goal 2 1)
=>
	(train scorpion-line)
	(chat-local-to-self "scorpion")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total scorpion-line less-than 5)
	(can-train scorpion-line)
	(goal 2 1)
=>
	(train scorpion-line)
	(chat-local-to-self "scorpion")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total scorpion-line less-than 8)
	(can-train scorpion-line)
	(goal 2 1)
=>
	(train scorpion-line)
	(chat-local-to-self "scorpion")
)

(defrule
	(unit-type-count-total cannon-galleon-line < 2)
	(can-train cannon-galleon-line)
	(goal 2 1)
=>
	(train cannon-galleon-line)
	(chat-local-to-self " cannon galleon ")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total cannon-galleon-line < 4)
	(can-train cannon-galleon-line)
	(goal 2 1)
=>
	(train cannon-galleon-line)
	(chat-local-to-self " cannon galleon ")
)

(defrule
    (cc-players-building-type-count 1 dock greater-than 0)
	(unit-type-count-total galley-line less-than 5)
	(can-train galley)
	(goal 2 1)
=>
	(train galley)
	(chat-local-to-self "galley")
)

(defrule
	(unit-type-count-total transport-ship < 2)
	(can-train transport-ship)
	(goal 2 1)
=>
	(train transport-ship)
	(chat-local-to-self " transport ship ")
)

(defrule
	(unit-type-count-total scout-cavalry-line < 1)
	(can-train scout-cavalry-line)
	(goal 2 1)
=>
	(train scout-cavalry-line)
	(chat-local-to-self " I'm scoutin!")
)

