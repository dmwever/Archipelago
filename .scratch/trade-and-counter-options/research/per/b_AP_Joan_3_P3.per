;Joan scn3 player 3
;English longbowmen

(load "scenario market")
(load "scenario upgrades DE")
(load "scenario difficulty DE")
(load "scenario upgrades")

(defrule
	(true)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-hunt-drop-distance 40)
	(set-strategic-number sn-maximum-town-size 25)
    (set-strategic-number sn-camp-max-distance 30)
    (set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-number-boat-explore-groups 2)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders  15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-gatherers 100)
	(set-strategic-number sn-food-gatherer-percentage  30)
	(set-strategic-number sn-gold-gatherer-percentage  30)
	(set-strategic-number sn-stone-gatherer-percentage 0)
	(set-strategic-number sn-wood-gatherer-percentage  40)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(set-strategic-number sn-maximum-wood-drop-distance 20)
	(disable-self)
)

(defrule
    (cc-players-building-type-count 1 dock > 0)
=>
	(enable-timer 7 2)
	(disable-self)
)

(defrule
	(timer-triggered 7)
=>
	(set-strategic-number sn-percent-attack-boats 100)
	(set-strategic-number sn-percent-attack-soldiers 0)
	(attack-now)
	(chat-local-to-self "attacking now with boats")
	(disable-timer 7)
	(enable-timer 7 500)
)

(defrule
    (cc-players-building-type-count 1 siege-workshop > 0)
=>
	(enable-timer 8 20)
	(disable-self)
)

(defrule
	(timer-triggered 8)
=>
	(set-strategic-number sn-percent-attack-boats 0)
	(set-strategic-number sn-percent-attack-soldiers 50)
	(attack-now)
	(disable-timer 8)
	(enable-timer 8 660)
)

;maintain housing
(defrule
	(housing-headroom less-than 4)
	(population-headroom greater-than 0)
	(can-build house)
=>
	(build house)
	(chat-local-to-self "house")
)


;BUILD UNITS
(defrule
    (cc-players-building-type-count 1 dock greater-than 0)
	(unit-type-count-total galley-line less-than 3)
	(can-train galley-line)
=>
	(train galley-line)
	(chat-local-to-self "galley")
)

;CONSTUCTION

;maintain a town center
(defrule
	(building-type-count town-center less-than 1)
	(can-build town-center)
=>
	(build town-center)
)

; villager count
(defrule
	(difficulty == easy)
	(unit-type-count-total villager less-than 20)
	(can-train villager)
=>
	(train villager)
)

(defrule
	(difficulty == moderate)
	(unit-type-count-total villager less-than 25)
	(can-train villager)
=>
	(train villager)
)

(defrule
	(difficulty == hard)
	(unit-type-count-total villager less-than 30)
	(can-train villager)
=>
	(train villager)
)

;maintain needed buildings
(defrule
	(building-type-count-total market less-than 1)
	(can-build market)
=>
	(build market)
)

(defrule
	(building-type-count-total dock less-than 1)
	(can-build dock)
=>
	(build dock)
	(disable-self)
)

(defrule
	(building-type-count-total mill less-than 1)
	(can-build mill)
=>
	(build mill)
)

(defrule
	(building-type-count-total archery-range less-than 1)
	(can-build archery-range)
=>
	(build archery-range)
)

(defrule
	(building-type-count-total blacksmith less-than 1)
	(can-build blacksmith)
=>
	(build blacksmith)
)

(defrule
	(building-type-count-total barracks less-than 2)
	(can-build barracks)
=>
	(build barracks)
)

(defrule
	(building-type-count-total stable less-than 2)
	(can-build stable)
=>
	(build stable)
)

(defrule
	(building-type-count-total university less-than 1)
	(can-build university)
=>
	(build university)
)

(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 5)
	(dropsite-min-distance wood > 5)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(resource-found gold)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance gold > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "gold place")
)

(defrule
	(resource-found stone)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance stone > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "rock place")
)

;construct farms if food gets short.
(defrule
	(idle-farm-count <= 1)
	(building-type-count-total farm less-than 20)
	(can-build farm)
=>
	(build farm)
)

;units
(defrule
	(difficulty == easy)
	(unit-type-count-total longbowman-line < 10)
	(can-train longbowman-line)
=>
	(train longbowman-line)
	(chat-local-to-self "longbowman")
)

(defrule
	(difficulty == moderate)
	(unit-type-count-total longbowman-line < 14)
	(can-train longbowman-line)
=>
	(train longbowman-line)
	(chat-local-to-self "longbowman")
)

(defrule
	(difficulty == hard)
	(unit-type-count-total longbowman-line < 18)
	(can-train longbowman-line)
=>
	(train longbowman-line)
	(chat-local-to-self "longbowman")
)

(defrule
	(difficulty == easy)
	(unit-type-count-total knight-line < 5)
	(can-train knight-line)
=>
	(train knight-line)
	(chat-local-to-self "knight")
)

(defrule
	(difficulty == moderate)
	(unit-type-count-total knight-line < 8)
	(can-train knight-line)
=>
	(train knight-line)
	(chat-local-to-self "knight")
)

(defrule
	(difficulty == hard)
	(unit-type-count-total knight-line < 12)
	(can-train knight-line)
=>
	(train knight-line)
	(chat-local-to-self "knight")
)

(defrule
	(difficulty == easy)
	(unit-type-count-total militiaman-line < 8)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "swordsman")
)

(defrule
	(difficulty == moderate)
	(unit-type-count-total militiaman-line < 12)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "swordsman")
)

(defrule
	(difficulty == hard)
	(unit-type-count-total militiaman-line < 15)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "swordsman")
)
