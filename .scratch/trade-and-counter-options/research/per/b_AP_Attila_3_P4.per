;Attila scenario 3 Player 4
;pike and archer 

(load "scenario upgrades DE")
(load "scenario difficulty DE")

(defrule
	(building-type-count town-center less-than 1)
=>
	(resign)
	(disable-self)
)

; GROUPS

(defrule
	(true)
=>
	(set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-town-size 25)
	(set-strategic-number sn-camp-max-distance 30)
	(set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-task-ungrouped-soldiers 1)
	(set-strategic-number sn-percent-attack-soldiers 50)
	(set-strategic-number sn-number-explore-groups 1)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(set-strategic-number sn-maximum-wood-drop-distance 20)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders 15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-gatherers 100)
	(set-strategic-number sn-food-gatherer-percentage  50)
	(set-strategic-number sn-gold-gatherer-percentage  0)
	(set-strategic-number sn-stone-gatherer-percentage 10)
	(set-strategic-number sn-wood-gatherer-percentage  40)
	(enable-timer 1 300)
	(enable-timer 2 300)
	(disable-self)
)

(defrule
	(difficulty <= moderate)
	(timer-triggered 2)
	(unit-type-count-total villager > 10)
=>
	(cc-add-resource gold 75)
	(disable-timer 2)
	(enable-timer 2 60)
)

(defrule
	(difficulty <= moderate)
	(timer-triggered 1)
	(defend-soldier-count >= 8)
=>
	(disable-timer 1)
	(enable-timer 1 560)
	(attack-now)
)	

(defrule
	(difficulty == easy)
	(unit-type-count-total villager less-than 20)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total villager less-than 30)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

(defrule
	(game-time < 3000)
	(unit-type-count-total fishing-ship < 4)
	(can-train fishing-ship)
=>
	(train fishing-ship)
	(chat-local-to-self "fishing ship")
)

(defrule
	(not(town-under-attack))
	(unit-type-count-total trade-cart < 3)
	(can-train trade-cart)
=>
	(train trade-cart)
	(chat-local-to-self "trade cart")
)

(defrule
	(not(town-under-attack))
	(unit-type-count-total trade-cog < 2)
	(can-train trade-cog)
=>
	(train trade-cog)
	(chat-local-to-self "trade cog")
)

;maintain housing
(defrule
	(housing-headroom less-than 4)
	(population-headroom greater-than 0)
	(can-build house)
=>
	(build house)
	(chat-local-to-self "house")
)

(defrule
	(building-type-count-total blacksmith less-than 1)
	(can-build blacksmith)
=>
	(build blacksmith)
	(chat-local-to-self "blacksmith")
)

(defrule
	(building-type-count-total barracks less-than 1)
	(can-build barracks)
=>
	(build barracks)
	(chat-local-to-self "barracks")
)

(defrule
	(difficulty == easy)	
	(idle-farm-count <= 1)
	(game-time greater-than 300)
	(building-type-count-total farm less-than 10)
	(can-build farm)
=>
	(build farm)
)

(defrule
	(difficulty <= moderate)	
	(idle-farm-count <= 1)
	(game-time greater-than 300)
	(building-type-count-total farm less-than 15)
	(can-build farm)
=>
	(build farm)
)

(defrule
	(food-amount less-than 100)
	(building-type-count-total farm less-than 12)
	(can-build farm)
=>
	(build farm)
)

(defrule
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "first wood place")
	(disable-self)
)

(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 5)
	(dropsite-min-distance wood > 5)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(resource-found stone)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance stone > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "rock place")
)

(defrule
	(building-type-count-total mill less-than 1)
=>
	(build mill)
	(chat-local-to-self "mill")
)

(defrule
	(building-type-count-total archery-range less-than 2)
=>
	(build archery-range)
	(chat-local-to-self "archery range")
)

; MILITARY UNITS

(defrule
	(difficulty <= moderate)
	(unit-type-count-total spearman-line less-than 12)
	(can-train spearman-line)
=>
	(train spearman)
	(chat-local-to-self "spearman")
)

(defrule
	(difficulty == easy)
	(unit-type-count-total militiaman-line less-than 6)
	(can-train militiaman-line)
=>
	(train militiaman)
	(chat-local-to-self "swordsman")
)

(defrule
	(difficulty == easy)
	(unit-type-count-total archer-line less-than 8)
	(can-train archer-line)
=>
	(train archer-line)
	(chat-local-to-self "archer")
)



(defrule
	(difficulty <= moderate)
	(unit-type-count-total archer-line less-than 18)
	(can-train archer-line)
=>
	(train archer-line)
	(chat-local-to-self "archer")
)
