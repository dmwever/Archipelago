;Attila scenario 4 Player 2
;Burgundy

(load "scenario market")
(load "scenario upgrades DE")
(load "scenario difficulty DE")
(load "scenario resign")

; RESIGNING

(defrule
	(building-type-count town-center < 1)
	(unit-type-count-total villager < 4)
	(game-time greater-than 1200)
=>
	(set-goal 1 19)
	(disable-self)
)

(defrule
	(or
		(players-stance 1 enemy)
		(players-stance 1 neutral)
	)
=>
	(set-stance 1 enemy)
	(disable-self)
)

(defrule
	(or
		(game-time > 1523)
		(building-type-count town-center < 1)
	)
=>
	(set-signal 5)	; ask to join
	(disable-self)
)

(defrule
	(event-detected trigger 2) ; tribute turned on
	(players-tribute 1 gold >= 500)
=>
	(set-signal 6)
	(disable-self)
)

(defrule
	(event-detected trigger 18)
	(not (timer-triggered 3))
	(building-type-count market > 0)
	(taunt-detected 1 38)
=>
	(chat-to-allies-using-id 22118)
	(acknowledge-taunt 1 38)
)	

(defrule
	(event-detected trigger 18)
	(building-type-count market less-than 1)
	(taunt-detected 1 38)
=>
	(chat-to-allies-using-id 22164)
	(acknowledge-taunt 1 38)
)	

(defrule
	(event-detected trigger 18)
	(timer-triggered 3)
	(taunt-detected 1 38)
	(building-type-count market > 0)
=>
	(tribute-to-player 1 gold 400)
	(tribute-to-player 1 food 500)
	(tribute-to-player 1 wood 400)
	(disable-timer 3)
	(enable-timer 3 300)
	(acknowledge-taunt 1 38)
)	

; GROUPS

(defrule
	(true)
=>
	(set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-town-size 18)
	(set-strategic-number sn-camp-max-distance 30)
	(set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(set-strategic-number sn-percent-attack-soldiers 50)
	(set-strategic-number sn-number-explore-groups 1)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders  15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-gatherers 100)
	(set-strategic-number sn-food-gatherer-percentage  33)
	(set-strategic-number sn-gold-gatherer-percentage  33)
	(set-strategic-number sn-stone-gatherer-percentage 0)
	(set-strategic-number sn-wood-gatherer-percentage  34)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(enable-timer 1 1200)
	(enable-timer 2 300)
	(disable-self)
)

(defrule
	(timer-triggered 2)
=>
	(set-strategic-number sn-task-ungrouped-soldiers 1)
	(chat-local-to-self "walking")
	(disable-timer 2)
	(enable-timer 3 30)
)

(defrule
	(timer-triggered 3)
=>
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(chat-local-to-self "not walking")
	(disable-timer 3)
	(enable-timer 2 300)
)
	
(defrule
	(event-detected trigger 18)
	(taunt-detected 1 31)
	(timer-triggered 4)
	(defend-soldier-count > 5)
=>	
	(attack-now)
	(disable-timer 1)
	(enable-timer 1 520)
	(disable-timer 4)
	(enable-timer 4 300)
	(acknowledge-taunt 1 31)
)

(defrule
	(event-detected trigger 18)
	(taunt-detected 1 31)
	(or
		(not(timer-triggered 4))
		(defend-soldier-count <= 5)
	)
=>	
	(chat-to-allies-using-id 22118)
	(acknowledge-taunt 1 31)
)

(defrule
	(or
		(difficulty <= moderate)
		(players-stance 1 ally)
	)
	(timer-triggered 1)
	(defend-soldier-count >= 10)
=>
	(attack-now)
	(chat-local-to-self "attack")
	(disable-timer 1)
	(enable-timer 1 520)
)

; Get your feet back on the ground when joining Huns
(defrule
	(event-detected trigger 18)
=>
	(cc-add-resource food 500)
	(cc-add-resource wood 700)
	(cc-add-resource gold 400)
	(cc-add-resource stone 400)
	(enable-timer 3 300)
	(enable-timer 4 300)
	(disable-self)
)

;========================CASTLE AGE RULES

(defrule
	(unit-type-count-total villager less-than 22)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

;maintain housing
(defrule
	(housing-headroom less-than 4)
	(population-headroom greater-than 0)
	(can-build house)
=>
	(build house)
	(chat-local-to-self "house")
)

;maintain a town center
(defrule
	(event-detected trigger 2)
	(building-type-count town-center less-than 1)
	(can-build town-center)
=>
	(build town-center)
)

(defrule
	(building-type-count-total archery-range less-than 2)
	(can-build archery-range)
=>
	(build archery-range)
	(chat-local-to-self "archery-range")
)

(defrule
	(building-type-count-total barracks less-than 2)
	(can-build barracks)
=>
	(build barracks)
	(chat-local-to-self "barracks")
)

(defrule
	(building-type-count-total blacksmith less-than 1)
	(can-build blacksmith)
=>
	(build blacksmith)
	(chat-local-to-self "blacksmith")
)

(defrule
	(building-type-count-total market less-than 1)
	(can-build market)
=>
	(build market)
	(chat-local-to-self "market")
)

;University & maintain it
(defrule
	(building-type-count-total university less-than 1)
	(can-build university)
=>
	(build university)
	(chat-local-to-self "university")
)

(defrule
	(building-type-count-total siege-workshop less-than 1)
	(can-build siege-workshop)
=>
	(build siege-workshop)
	(chat-local-to-self "siege workshop")
)

;construct farms if food getting short.
(defrule
	(idle-farm-count <= 1)
	(game-time greater-than 300)
	(building-type-count-total farm less-than 7)
	(can-build farm)
=>
	(build farm)
)

(defrule
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "first wood place")
	(disable-self)
)

(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 5)
	(dropsite-min-distance wood > 5)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(resource-found gold)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance gold > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "gold place")
)

(defrule
	(resource-found stone)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance stone > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "rock place")
)

(defrule
	(dropsite-min-distance food greater-than 4)
	(building-type-count-total mill less-than 4)
	(can-build mill)
=>
	(build mill)
	(chat-local-to-self "mill")
)

; MILITARY UNITS


(defrule
	(unit-type-count-total militiaman-line < 20)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "infantry")
)

(defrule
	(or
		(difficulty <= moderate)
		(players-stance 1 ally)
	)
	(unit-type-count-total archer-line < 15)
	(can-train archer-line)
=>
	(train archer-line)
	(chat-local-to-self "archer")
)

(defrule
	(not (town-under-attack))
	(unit-type-count-total battering-ram-line < 3)
	(can-train battering-ram-line)
=>
	(train battering-ram-line)
	(chat-local-to-self "rammage")
)

