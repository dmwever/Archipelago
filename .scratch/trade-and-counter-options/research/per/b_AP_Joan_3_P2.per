;Joan scn3 player 2
;Burgundy

(load "scenario market")
(load "scenario upgrades DE")
(load "scenario difficulty DE")
(load "scenario resign")

(defconst gl-available-food-amount 10)
(defconst temporary-goal 11)

(defrule
	(or
		(not (player-in-game 3))
		(and
			(and
				(unit-type-count-total villager < 2)
				(not (can-train villager) )
			)
			(event-detected trigger 1) ; At least one castle is down
		)
	)
=>
	(set-goal 1 19)
	(disable-self)
)

(defrule
	(true)
=>
	(up-get-fact food-amount 0 gl-available-food-amount)
	(up-get-fact escrow-amount food temporary-goal)
	(up-modify-goal gl-available-food-amount g:- temporary-goal)
)

(defrule
	(true)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-hunt-drop-distance 40)
	(set-strategic-number sn-maximum-town-size 20)
    (set-strategic-number sn-camp-max-distance 30)
    (set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 15)
	(set-strategic-number sn-blot-exploration-map 1)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders 20)
	(set-strategic-number sn-percent-civilian-gatherers 80)
	(set-strategic-number sn-food-gatherer-percentage  45)
	(set-strategic-number sn-gold-gatherer-percentage  20)
	(set-strategic-number sn-stone-gatherer-percentage 5)
	(set-strategic-number sn-wood-gatherer-percentage  30)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(enable-timer 2 300)
	(disable-self)
)

(defrule
    (true)
=>
	(set-strategic-number sn-number-explore-groups 2)
	(set-strategic-number sn-percent-attack-soldiers 75)
	(disable-self)
)

(defrule
	(timer-triggered 2)
=>
	(set-strategic-number sn-task-ungrouped-soldiers 1)
	(disable-timer 2)
	(enable-timer 3 5)
	(disable-self)
)

(defrule
	(timer-triggered 3)
=>
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(disable-timer 3)
	(enable-timer 2 300)
	(disable-self)
)

(defrule
	(difficulty == easy)
=>
	(enable-timer 1 2000)
	(disable-self)
)

(defrule
	(difficulty == moderate)
=>
	(set-strategic-number sn-cap-civilian-builders 3)
	(enable-timer 1 1200)
	(disable-self)
)

(defrule
	(difficulty == hard)
=>
	(set-strategic-number sn-cap-civilian-builders 5)
	(enable-timer 1 900)
	(disable-self)
)

(defrule
	(timer-triggered 1)
	(defend-soldier-count > 8)
=>
	(attack-now)
	(disable-timer 1)
	(enable-timer 1 600)
)

; villager count
(defrule
	(difficulty == easy)
	(unit-type-count-total villager less-than 18)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "civilian easy")
)

(defrule
	(difficulty == moderate)
	(unit-type-count-total villager less-than 25)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "civilian")
)

(defrule
	(difficulty == hard)
	(unit-type-count-total villager less-than 32)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "civilian")
)

;maintain housing
(defrule
	(housing-headroom less-than 4)
	(population-headroom greater-than 0)
	(can-build house)
=>
	(build house)
	(chat-local-to-self "house")
)

;maintain a town center
(defrule
	(building-type-count town-center less-than 1)
	(can-build town-center)
=>
	(build town-center)
)

; Build a mill when we find food
(defrule
	(building-type-count-total mill less-than 1)
	(can-build mill)
=>
	(chat-local-to-self "mill")
	(build mill)
	(disable-self)
)

(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 5)
	(dropsite-min-distance wood > 5)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(resource-found gold)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance gold > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "gold place")
)

(defrule
	(resource-found stone)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance stone > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "rock place")
)

(defrule
	(difficulty == easy)
	(building-type-count-total barracks less-than 1)
	(can-build barracks)
=>
	(build barracks)
	(chat-local-to-self "barracks")
)

(defrule
	(difficulty <= moderate)
	(building-type-count-total barracks less-than 2)
	(can-build barracks)
=>
	(build barracks)
	(chat-local-to-self "barracks")
)

(defrule
	(building-type-count-total market less-than 1)
	(can-build market)
=>
	(build market)
	(chat-local-to-self "market")
)

;get a blacksmith
(defrule
	(building-type-count-total blacksmith less-than 1)
	(can-build blacksmith)
=>
	(build blacksmith)
	(chat-local-to-self "blacksmith")
)

 (defrule
	(building-type-count siege-workshop less-than 1)
	(can-build siege-workshop)
=>
	(build siege-workshop)
	(chat-local-to-self "siege workshop")
)

;construct farms if food gets short.
(defrule
	(game-time > 60)
	(idle-farm-count <= 1)
	(building-type-count-total farm less-than 15)
	(can-build farm)
=>
	(build farm)
)

; CASTLE AGE

;units

(defrule
	(difficulty == easy)
	(up-compare-goal gl-available-food-amount > 110)
	(unit-type-count-total militiaman-line < 10)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "sword")
)

(defrule
	(difficulty == moderate)
	(up-compare-goal gl-available-food-amount > 60)
	(unit-type-count-total militiaman-line < 15)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "sword")
)

(defrule
	(difficulty == hard)
	(up-compare-goal gl-available-food-amount > 60)
	(unit-type-count-total militiaman-line < 20)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "sword")
)

(defrule
	(difficulty == easy)
	(up-compare-goal gl-available-food-amount > 110)
	(unit-type-count-total spearman-line < 8)
	(can-train spearman-line)
=>
	(train spearman-line)
	(chat-local-to-self "spear")
)

(defrule
	(difficulty == moderate)
	(up-compare-goal gl-available-food-amount > 60)
	(unit-type-count-total spearman-line < 12)
	(can-train spearman-line)
=>
	(train spearman-line)
	(chat-local-to-self "spear")
)

(defrule
	(difficulty == hard)
	(up-compare-goal gl-available-food-amount > 60)
	(unit-type-count-total spearman-line < 15)
	(can-train spearman-line)
=>
	(train spearman-line)
	(chat-local-to-self "spear")
)

(defrule
	(unit-type-count-total mangonel-line < 1)
	(can-train mangonel-line)
=>
	(train mangonel-line)
	(chat-local-to-self "mangonel")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total mangonel-line < 4)
	(can-train mangonel-line)
=>
	(train mangonel-line)
	(chat-local-to-self "mangonel")
)

 (defrule
	(difficulty <= moderate)
	(building-type-count-total watch-tower-line < 5)
	(can-build watch-tower-line)
=>
	(build watch-tower-line)
	(chat-local-to-self "build tower")
)

;tribute rules

(defrule
    (current-age equal castle-age)
	(wood-amount greater-than 800)
=>
	(tribute-to-player 4 wood 100)
)

(defrule
    (current-age equal castle-age)
	(food-amount greater-than 800)
=>
	(tribute-to-player 4 food 100)
)

(defrule
    (current-age equal castle-age)
	(gold-amount greater-than 800)
=>
	(tribute-to-player 4 gold 100)
)

;if player 3 is being attacked, send a lot all at once
(defrule
    (cc-players-building-type-count 3 castle less-than 4)
=>
	(tribute-to-player 4 wood 200)
	(tribute-to-player 4 wood 200)
	(tribute-to-player 4 wood 200)
	(tribute-to-player 4 wood 200)
	(tribute-to-player 4 wood 200)
	(disable-self)
)

(defrule
    (cc-players-building-type-count 3 castle less-than 4)
=>
	(tribute-to-player 4 food 200)
	(tribute-to-player 4 food 200)
	(tribute-to-player 4 food 200)
	(tribute-to-player 4 food 200)
	(tribute-to-player 4 food 200)
	(disable-self)
)

(defrule
    (cc-players-building-type-count 3 castle less-than 4)
=>
	(tribute-to-player 4 gold 200)
	(tribute-to-player 4 gold 200)
	(tribute-to-player 4 gold 200)
	(tribute-to-player 4 gold 200)
	(tribute-to-player 4 gold 200)
	(disable-self)
)

;if player 3 is still being attacked, send more
(defrule
    (cc-players-building-type-count 3 castle less-than 3)
=>
	(tribute-to-player 4 wood 200)
	(tribute-to-player 4 wood 200)
	(tribute-to-player 4 wood 200)
	(tribute-to-player 4 wood 200)
	(tribute-to-player 4 wood 200)
	(disable-self)
)

(defrule
    (cc-players-building-type-count 3 castle less-than 3)
=>
	(tribute-to-player 4 food 200)
	(tribute-to-player 4 food 200)
	(tribute-to-player 4 food 200)
	(tribute-to-player 4 food 200)
	(tribute-to-player 4 food 200)
	(disable-self)
)

(defrule
    (cc-players-building-type-count 3 castle less-than 3)
=>
	(tribute-to-player 4 gold 200)
	(tribute-to-player 4 gold 200)
	(tribute-to-player 4 gold 200)
	(tribute-to-player 4 gold 200)
	(tribute-to-player 4 gold 200)
	(disable-self)
)

;if player 3 is _still_ being attacked, keep helping
(defrule
    (cc-players-building-type-count 3 castle less-than 2)
=>
	(tribute-to-player 4 wood 200)
	(tribute-to-player 4 wood 200)
	(tribute-to-player 4 wood 200)
	(tribute-to-player 4 wood 200)
	(tribute-to-player 4 wood 200)
	(disable-self)
)

(defrule
    (cc-players-building-type-count 3 castle less-than 2)
=>
	(tribute-to-player 4 food 200)
	(tribute-to-player 4 food 200)
	(tribute-to-player 4 food 200)
	(tribute-to-player 4 food 200)
	(tribute-to-player 4 food 200)
	(disable-self)
)

(defrule
    (cc-players-building-type-count 3 castle less-than 2)
=>
	(tribute-to-player 4 gold 200)
	(tribute-to-player 4 gold 200)
	(tribute-to-player 4 gold 200)
	(tribute-to-player 4 gold 200)
	(tribute-to-player 4 gold 200)
	(disable-self)
)
