; All Scn 1 Mongols

(load "scenario difficulty DE")

(defrule
	(not (players-stance 1 ally))
=>
	(set-stance 1 enemy)
)

 (defrule
	(true)
=>
	; Do all one-time universal rules
	(set-strategic-number sn-maximum-gaia-attack-response   5)
	(set-strategic-number sn-food-gatherer-percentage 40)
	(set-strategic-number sn-wood-gatherer-percentage 30)
	(set-strategic-number sn-stone-gatherer-percentage 15)
	(set-strategic-number sn-gold-gatherer-percentage 15)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(disable-self)
)

; House Supply
(defrule
  (housing-headroom less-or-equal 3)
  (population-headroom greater-than 0)
  (can-afford-building house)
  (can-build house)
=>

  (build house)
)

;Build mills
(defrule
   (building-type-count-total mill less-than 3)
	(dropsite-min-distance food greater-than 8)
	(can-build mill)
=>

	(build mill)
)

;Build lumber-camps
(defrule
   (dropsite-min-distance wood greater-than 8)
	(can-build lumber-camp)
   (building-type-count-total lumber-camp less-than 4)
=>
	(build lumber-camp)
)

;Build a monastery
(defrule
        ( can-afford-building  monastery )
        ( can-build monastery)
        ( building-type-count-total monastery less-than 1 )
=>
        (build monastery)
)

;Build a blacksmith
(defrule
   ( can-build blacksmith )
	( building-type-count-total blacksmith less-than 1 )
=>
	(build blacksmith)
)

; Build a stone mine camp
(defrule
	(dropsite-min-distance stone greater-than 7)
   (building-type-count mining-camp less-than 4)
	(can-build mining-camp)
=>
	(build mining-camp)
)

 (defrule
	(building-type-count-total farm less-than 13)
	(can-build farm)
	(can-afford-building farm)
=>
	(build farm)
)

(defrule
	(can-build market)
   (civilian-population greater-than 20)
	(building-type-count-total market less-than 1)
=>
	(build market)
)

;University is good.
(defrule
   (civilian-population greater-than 20)
	(building-type-count university less-than 1)
	(can-build university)
	(can-afford-building university)
=>
	(build university)
)

(defconst gl-loop 100)
(defconst gl-ornlu-id 101)
(defconst gl-object-x 102)
(defconst gl-object-y 103)
(defconst object-data-player 20)
(defconst object-data-distance 44)
(defconst ornlu-attack-timer 25)
#load-if-defined DIFFICULTY-EASIEST
(defconst ornlu-range 2)
(defconst ornlu-timer 8)
#end-if
#load-if-defined DIFFICULTY-EASY
(defconst ornlu-range 3)
(defconst ornlu-timer 7)
#end-if
#load-if-defined DIFFICULTY-MODERATE
(defconst ornlu-range 4)
(defconst ornlu-timer 6)
#end-if
#load-if-defined DIFFICULTY-HARD
(defconst ornlu-range 5)
(defconst ornlu-timer 5)
#end-if
#load-if-defined DIFFICULTY-HARDEST
(defconst ornlu-range 6)
(defconst ornlu-timer 4)
#end-if
#load-if-defined DIFFICULTY-EXTREME
(defconst ornlu-range 7)
(defconst ornlu-timer 3)
#end-if
#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined DIFFICULTY-MODERATE
#load-if-not-defined DIFFICULTY-HARD
#load-if-not-defined DIFFICULTY-HARDEST
#load-if-not-defined DIFFICULTY-EXTREME
(defconst ornlu-range 8)
(defconst ornlu-timer 2)
#end-if
#end-if
#end-if
#end-if
#end-if
#end-if
(defrule
	(goal gl-ornlu-id -1)
=>
	(set-goal gl-loop 0)
)
(defrule
	(goal gl-ornlu-id -1)
	(up-compare-goal gl-loop < 20000)
	(up-set-target-by-id g: gl-loop)
	(up-object-data object-data-type == 707) ; object id.
=>
	(up-set-target-by-id g: gl-loop)
	(up-get-object-data object-data-id gl-ornlu-id)
)
(defrule
	(goal gl-ornlu-id -1)
	(up-compare-goal gl-loop < 20000)
=>
	(up-modify-goal gl-loop c:+ 1)
	(up-jump-rule -2)
)
(defrule
	(up-compare-goal gl-ornlu-id != -1)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-ornlu-id)
	(up-set-target-object search-local c: 0)
	(up-get-point position-object gl-object-x)
	(up-set-target-point gl-object-x)
	(set-goal gl-loop 0)
)
(defrule
	(up-compare-goal gl-ornlu-id != -1)
	(up-compare-goal gl-loop < 20000)
	(up-set-target-by-id g: gl-loop)
	(up-object-data object-data-player == 1)
	(up-object-data object-data-distance <= ornlu-range)
	(up-timer-status ornlu-attack-timer != timer-running)
=>
	(up-add-object-by-id search-remote g: gl-loop)
	(up-set-target-object search-remote c: 0)
	(up-target-objects 1 action-default -1 -1)
	(enable-timer ornlu-attack-timer ornlu-timer)
	(up-jump-rule 1)
)
(defrule
	(up-compare-goal gl-ornlu-id != -1)
	(up-compare-goal gl-loop < 20000)
=>
	(up-modify-goal gl-loop c:+ 1)
	(up-jump-rule -2)
)	

