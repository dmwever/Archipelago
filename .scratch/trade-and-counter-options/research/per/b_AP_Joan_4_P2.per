;Joan of Arc scenario 4 player 2
;Troyes - Orange
;Knights and spears

(load "scenario market")
(load "scenario upgrades DE")
(load "scenario difficulty DE")
(load "scenario resign")


(defrule ; TC has been destroyed, pacify player
	(event-detected trigger 25)
=>
	(set-strategic-number sn-food-gatherer-percentage 60)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
	(set-strategic-number sn-wood-gatherer-percentage 40)
	(set-strategic-number sn-maximum-town-size 15)
	(set-goal 1 20)
	(set-goal 2 10)
	(disable-self)
)

(defrule
	(goal 1 20)
=>
	(delete-building barracks)
	(delete-building archery-range)
	(delete-building stable)
	(delete-building siege-workshop)
	(delete-building castle)
	(delete-building watch-tower)
	(delete-building guard-tower)
	(delete-building keep)
	(delete-building bombard-tower)
	(delete-building mining-camp)
)

(defrule
	(goal 1 20)
=>
	(delete-unit militiaman)
	(delete-unit man-at-arms)
	(delete-unit long-swordsman)
	(delete-unit two-handed-swordsman)
	(delete-unit champion)
	(delete-unit petard)
	(delete-unit spearman)
	(delete-unit pikeman)
	(delete-unit halberdier)
)

(defrule
	(goal 1 20)
=>
	(delete-unit archer)
	(delete-unit crossbowman)
	(delete-unit arbalest)
	(delete-unit skirmisher)
	(delete-unit elite-skirmisher)
	(delete-unit imperial-skirmisher)
	(delete-unit scout-cavalry)
	(delete-unit light-cavalry)
	(delete-unit hussar)
	(delete-unit knight)
)

(defrule
	(goal 1 20)
=>
	(delete-unit cavalier)
	(delete-unit paladin)
	(delete-unit my-unique-unit)
	(delete-unit galley)
	(delete-unit war-galley)
	(delete-unit galleon)
	(delete-unit cannon-galleon)
	(delete-unit fire-ship)
	(delete-unit fast-fire-ship)
	(delete-unit battering-ram)
	(delete-unit capped-ram)
)

(defrule
	(goal 1 20)
=>
	(delete-unit siege-ram)
	(delete-unit mangonel)
	(delete-unit onager)
	(delete-unit siege-onager)
	(delete-unit scorpion)
	(delete-unit heavy-scorpion)
	(delete-unit transport-ship)
	(delete-unit hand-cannoneer)
	(delete-unit bombard-cannon)
	(delete-unit demolition-ship)
	(delete-unit heavy-demolition-ship)
)

(defrule
	(goal 1 20)
	(military-population == 0)
	(building-type-count watch-tower-line == 0)
	(building-type-count bombard-tower == 0)
	(building-type-count castle == 0)
=>
	(set-goal 1 1)
	(disable-self)
)

; START

(defrule
	(true)
=>
	(set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-number-boat-explore-groups 1)
	(set-strategic-number sn-task-ungrouped-soldiers 1)
	(set-strategic-number sn-wall-targeting-mode 1)
	(set-goal 2 1)
	(disable-self)
)

(defrule
	(true)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-town-size 10)
    (set-strategic-number sn-camp-max-distance 30)
    (set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
	(disable-self)
)

(defrule
	(game-time > 600)
=>
	(set-strategic-number sn-maximum-town-size 25)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-food-gatherer-percentage 40)
	(set-strategic-number sn-gold-gatherer-percentage 30)
	(set-strategic-number sn-stone-gatherer-percentage 5)
	(set-strategic-number sn-wood-gatherer-percentage 25)
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders 15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(enable-timer 4 3600)
	(disable-self)
)

(defrule
	(difficulty == easy)
=>
	(enable-timer 1 2000)
	(disable-self)
)

(defrule
	(difficulty == moderate)
=>
	(set-strategic-number sn-cap-civilian-builders 3)
	(enable-timer 1 1500)
	(disable-self)
)

(defrule
	(difficulty == hard)
=>
	(set-strategic-number sn-cap-civilian-builders 5)
	(enable-timer 1 1200)
	(disable-self)
)

; in case of long game, break glass
(defrule
	(timer-triggered 4)
	(goal 2 1)
=>
	(chat-local-to-self "I think I need some resources")
	(cc-add-resource food 400)
	(cc-add-resource wood 400)
	(cc-add-resource gold 400)
	(disable-timer 4)
	(enable-timer 4 2700)
)

(defrule
    (cc-players-building-type-count 1 dock greater-than 0)
	(warboat-count > 3)
	(goal 2 1)
=>
	(set-strategic-number sn-percent-attack-boats 100%)
	(set-strategic-number sn-percent-attack-soldiers 0%)
	(attack-now)
	(chat-local-to-self "three warships so naval attack")
)

(defrule
	(timer-triggered 1)
	(defend-soldier-count > 14)
	(goal 2 1)
=>
	(set-strategic-number sn-percent-attack-boats 0%)
	(set-strategic-number sn-percent-attack-soldiers 60%)
	(attack-now)
	(chat-local-to-self "14 units so attacking")
	(disable-timer 1)
	(enable-timer 1 900)
)

;BUILD & MAINTAIN BUILDINGS
(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 5)
	(dropsite-min-distance wood > 5)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(resource-found gold)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance gold > 7)
	(can-build mining-camp)
	(goal 2 1)
=>
	(build mining-camp)
	(chat-local-to-self "gold place")
)

(defrule
	(resource-found stone)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance stone > 7)
	(can-build mining-camp)
	(goal 2 1)
=>
	(build mining-camp)
	(chat-local-to-self "rock place")
)

(defrule
	(building-type-count-total market less-than 1)
	(can-build market)
	(goal 2 1)
=>
	(build market)
	(chat-local-to-self "market")
)

(defrule
	(building-type-count-total mill less-than 1)
	(can-build mill)
=>
	(build mill)
	(chat-local-to-self "mill")
)

(defrule
	(building-type-count-total dock less-than 1)
	(can-build dock)
	(goal 2 1)
=>
	(build dock)
	(chat-local-to-self "dock")
)

(defrule
	(building-type-count-total barracks less-than 2)
	(can-build barracks)
	(goal 2 1)
=>
	(build barracks)
	(chat-local-to-self "barracks")
)

(defrule
	(building-type-count-total stable less-than 2)
	(can-build stable)
	(goal 2 1)
=>
	(build stable)
	(chat-local-to-self "stable")
)

(defrule
	(building-type-count-total blacksmith less-than 1)
	(can-build blacksmith)
	(goal 2 1)
=>
	(build blacksmith)
	(chat-local-to-self "smith")
)

;sneaky stuff
(defrule
	(game-time > 600)
	(building-type-count-total barracks < 2)
	(can-build barracks)
	(goal 2 1)
=>
	(build-forward barracks)
	(chat-local-to-self "forward barracks")
	(disable-self)
)

(defrule
	(game-time > 600)
	(building-type-count-total stable < 2)
	(can-build stable)
	(goal 2 1)
=>
	(build-forward stable)
	(chat-local-to-self "forward stable")
	(disable-self)
)

(defrule
	(building-type-count-total town-center < 1)
	(can-build town-center)
	(goal 2 10)
=>
	(build town-center)
	(chat-local-to-self "town center")
	(disable-self)
)

; villager count
(defrule
	(unit-type-count-total villager less-than 10)
	(can-train villager)
	(goal 2 10)
=>
	(train villager)
	(chat-local-to-self "civilian easy")
)

(defrule
	(difficulty == easy)
	(unit-type-count-total villager less-than 18)
	(can-train villager)
	(goal 2 1)
=>
	(train villager)
	(chat-local-to-self "civilian easy")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total villager less-than 45)
	(can-train villager)
	(goal 2 1)
=>
	(train villager)
	(chat-local-to-self "civilian")
)

(defrule
    (cc-players-building-type-count 1 dock greater-than 0)
	(goal 2 1)
=>
	(set-strategic-number sn-number-boat-explore-groups 1)
)

(defrule
    (cc-players-building-type-count 1 dock greater-than 0)
	(unit-type-count-total galley-line less-than 5)
	(can-train galley)
	(goal 2 1)
=>
	(train galley)
	(chat-local-to-self "galley")
)

(defrule
	(unit-type-count-total fishing-ship less-than 7)
	(game-time < 2800)
	(can-train fishing-ship)
	(goal 2 1)
=>
	(train fishing-ship)
	(chat-local-to-self "fishing ship")
)

;maintain housing
(defrule
	(housing-headroom less-than 4)
	(population-headroom greater-than 0)
	(can-build house)
=>
	(build house)
	(chat-local-to-self "house")
)

;construct farms
(defrule
	(idle-farm-count <= 1)
	(building-type-count-total farm less-than 20)
	(can-build farm)
=>
	(build farm)
	(chat-local-to-self "farm")
)

(defrule
	(unit-type-count-total spearman-line < 18)
	(or
		(unit-type-count-total knight-line > 2)
		(town-under-attack)
	)
	(can-train spearman-line)
	(goal 2 1)
=>
	(train spearman-line)
	(chat-local-to-self "spearman")
)

(defrule
	(unit-type-count-total spearman-line < 30)
	(difficulty <= moderate)
	(or
		(unit-type-count-total knight-line > 2)
		(town-under-attack)
	)
	(can-train spearman-line)
	(goal 2 1)
=>
	(train spearman-line)
	(chat-local-to-self "spearman")
)

(defrule
	(unit-type-count-total knight-line < 7)
	(can-train knight-line)
	(goal 2 1)
=>
	(train knight-line)
	(chat-local-to-self "train knight")
)

(defrule
	(unit-type-count-total knight-line < 18)
	(difficulty <= moderate)
	(can-train knight-line)
	(goal 2 1)
=>
	(train knight-line)
	(chat-local-to-self "train knight")
)

(defrule
	(unit-type-count-total scout-cavalry-line < 1)
	(can-train scout-cavalry-line)
	(goal 2 1)
=>
	(train scout-cavalry-line)
	(chat-local-to-self " I'm scoutin!")
)

