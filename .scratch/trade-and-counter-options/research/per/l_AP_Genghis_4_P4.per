;Mongols scenario 4 Player 4
;Khwarazm

(load "scenario market")
(load "scenario upgrades DE")
(load "scenario difficulty DE")
(load "scenario resign FE")


;Savar Upgrade
(defrule
	(game-time greater-than 900)
	(unit-type-count-total cavalier > 4)
	(can-research-with-escrow ri-savar)
=>
	(release-escrow wood)
	(release-escrow food)
	(release-escrow gold)
	(release-escrow stone)
	(research ri-savar)
	(chat-local-to-self "research savar")
)

;RELEASE ESCROW
(defrule
	(not (players-stance 1 ally))
=>	
	(enable-timer 19 900) ; Release escrow
	(disable-self)
)

(defrule ; don't hold on to resources
	(timer-triggered 19)
=>
	(release-escrow wood)
	(release-escrow food)
	(release-escrow gold)
	(release-escrow stone)
	(disable-timer 19)
	(enable-timer 19 600)
)

(defrule
	(building-type-count wonder < 1)
	(building-type-count castle < 1)
=>
	(set-goal 1 19)
	(disable-self)
)

; Keeps Persia from retaliating too early
(defrule
	(not (event-detected trigger 16))
	(players-stance 1 enemy)
=>
	(set-stance 1 enemy)
)

; GROUPS

(defrule
	(true)
=>
        (set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-town-size 25)
        (set-strategic-number sn-camp-max-distance 30)
        (set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(set-strategic-number sn-number-explore-groups 2)
	(set-strategic-number sn-attack-intelligence 1)
	(set-strategic-number sn-wall-targeting-mode 1)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders  15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-gatherers 100)
	(set-strategic-number sn-food-gatherer-percentage  30)
	(set-strategic-number sn-gold-gatherer-percentage  25)
	(set-strategic-number sn-stone-gatherer-percentage 20)
	(set-strategic-number sn-wood-gatherer-percentage  25)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(disable-self)
)

(defrule
	(true)
=>
	(enable-timer 4 3600)
	(disable-self)
)

; in case of long game, break glass
(defrule
	(timer-triggered 4)
=>
	(cc-add-resource food 700)
	(cc-add-resource wood 700)
	(cc-add-resource gold 700)
	(disable-timer 4)
	(enable-timer 4 2700)
)


(defrule
	(event-detected trigger 4)
=>
	(chat-local-to-self "Shah not dead")
	(cc-add-resource food 3000)
	(cc-add-resource wood 3000)
	(cc-add-resource gold 3000)
	(disable-self)
)

(defrule
	(event-detected trigger 1)
=>
	(chat-local-to-self "start attack behavior in 20")
	(enable-timer 3 20)
	(disable-self)
)

(defrule
	(timer-triggered 3)
=>
	(set-strategic-number sn-task-ungrouped-soldiers 1)
	(enable-timer 6 720)
	(disable-self)
)

(defrule
	(timer-triggered 6)
=>
	(set-strategic-number sn-percent-attack-soldiers 25)
	(chat-local-to-self "first attack")
	(attack-now)
	(disable-timer 6)
	(enable-timer 6 710)
	(disable-self)
)

(defrule
	(timer-triggered 6)
=>
	(set-strategic-number sn-percent-attack-soldiers 50)
	(attack-now)
	(chat-local-to-self "subsequent attacks")
	(disable-timer 6)
	(enable-timer 6 1200)
)

(defrule
	(event-detected trigger 4)
	(unit-type-count-total villager less-than 35)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

(defrule
	(not(event-detected trigger 4))
	(unit-type-count-total villager less-than 20)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

;maintain housing
(defrule
	(housing-headroom less-than 4)
	(population-headroom greater-than 0)
	(can-build house)
=>
	(build house)
	(chat-local-to-self "house")
)

;maintain a town center
(defrule
	(game-time greater-than 45)
	(building-type-count town-center less-than 1)
	(can-build town-center)
=>
	(build town-center)
)

(defrule
	(building-type-count-total archery-range less-than 1)
	(can-build archery-range)
=>
	(build archery-range)
	(chat-local-to-self "archery range")
)

(defrule
	(building-type-count-total blacksmith less-than 1)
	(can-build blacksmith)
=>
	(build blacksmith)
	(chat-local-to-self "blacksmith")
)

(defrule
	(building-type-count-total market less-than 1)
	(can-build market)
=>
	(build market)
	(chat-local-to-self "market")
)

(defrule
	(building-type-count-total stable less-than 1)
	(can-build stable)
=>
	(build stable)
	(chat-local-to-self "stable")
)

(defrule
	(building-type-count-total university less-than 1)
	(can-build university)
=>
	(build university)
	(chat-local-to-self "university")
)

(defrule
	(building-type-count-total castle less-than 1)
	(can-build castle)
=>
	(build castle)
	(chat-local-to-self "castle")
)

(defrule
	(building-type-count-total siege-workshop less-than 1)
	(can-build siege-workshop)
=>
	(build siege-workshop)
	(chat-local-to-self "siege workshop")
)

;construct farms if food getting short.
(defrule
	(game-time > 300)
	(building-type-count-total farm less-than 10)
	(can-build farm)
=>
	(build farm)
	(chat-local-to-self "farm")
)

(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 5)
	(dropsite-min-distance wood > 5)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(resource-found gold)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance gold > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "gold place")
)

(defrule
	(resource-found stone)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance stone > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "rock place")
)

(defrule
	(building-type-count-total mill less-than 1)
	(can-build mill)
=>
	(build mill)
	(chat-local-to-self "mill")
)

; UNITS


;===NOT HARD===

(defrule
	(not (difficulty == hard))
	(unit-type-count-total monk less-than 1)
	(can-train monk)
=>
	(train monk)
	(chat-local-to-self "monk")
)

(defrule
	(not (difficulty == hard))
	(unit-type-count-total cavalry-archer-line less-than 8)
	(can-train cavalry-archer-line)
=>
	(train cavalry-archer-line)
	(chat-local-to-self "cav archer")
)

(defrule
	(not (difficulty == hard))
	(unit-type-count-total knight-line less-than 8)
	(can-train knight-line)
=>
	(train knight-line)
	(chat-local-to-self "knight")
)

(defrule
	(unit-type-count-total scout-cavalry-line less-than 2)
	(can-train scout-cavalry-line)
=>
	(train scout-cavalry-line)
	(chat-local-to-self " scout ")
)


(defrule
	(not (difficulty == hard))
        (unit-type-count-total war-elephant-line less-than 8)
        (can-train war-elephant-line)
=>
        (train war-elephant-line)
        (chat-local-to-self "boar")
)

;Scorpion
(defrule	
	(not (difficulty == normal))
	(unit-type-count-total scorpion-line < 1)
	(can-train scorpion-line)
=>
	(train scorpion-line)
	(chat-local-to-self "Scorpion")
)

;Trebuchet Moderate
(defrule
	(difficulty == moderate)
	(unit-type-count-total trebuchet-set < 1)
	(can-train trebuchet)
=>
	(train trebuchet)
)


;===HARD===

(defrule
	(difficulty == hard)
	(unit-type-count-total monk less-than 2)
	(can-train monk)
=>
	(train monk)
	(chat-local-to-self "monk")
)

(defrule
	(difficulty == hard)
	(unit-type-count-total cavalry-archer-line less-than 10)
	(can-train cavalry-archer-line)
=>
	(train cavalry-archer-line)
	(chat-local-to-self "cav archer")
)

(defrule
	(difficulty == hard)
	(unit-type-count-total knight-line less-than 11)
	(can-train knight-line)
=>
	(train knight-line)
	(chat-local-to-self "knight")
)


(defrule
	(difficulty == hard)
        (unit-type-count-total war-elephant-line less-than 11)
        (can-train war-elephant-line)
=>
        (train war-elephant-line)
        (chat-local-to-self "boar")
)

;Scorpion
(defrule	
	(difficulty == hard)
	(unit-type-count-total scorpion-line < 3)
	(can-train scorpion-line)
=>
	(train scorpion-line)
	(chat-local-to-self "Scorpion")
)

;Trebuchet Hard
(defrule
	(difficulty == hard)
	(unit-type-count-total trebuchet-set < 2)
	(can-train trebuchet)
=>
	(train trebuchet)
)


;================CHEAT======================

; Cheat

;***Cheats***


(defrule
	(event-detected trigger 99)
=>
	(enable-timer 9 0)
	(enable-timer 10 0)
	(enable-timer 11 0)
	(disable-self)
)

;FOOD

(defrule
	(timer-triggered 9)
	(difficulty == easy)
	(food-amount < 200)
=>
	(cc-add-resource food 60)
	(disable-timer 9)
	(enable-timer 9 60)
)

(defrule
	(timer-triggered 9)
	(difficulty == moderate)
	(food-amount < 400)
=>
	(cc-add-resource food 112)
	(disable-timer 9)
	(enable-timer 9 60)
)

(defrule
	(timer-triggered 9)
	(difficulty == hard)
	(food-amount < 900)
=>
	(cc-add-resource food 112)
	(disable-timer 9)
	(enable-timer 9 60)
)


