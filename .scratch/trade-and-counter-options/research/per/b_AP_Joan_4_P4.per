;Joan of Arc scenario 4 p4
;Rheims - yellow
;Longbowmen, knights and siege

(load "scenario market")
(load "scenario upgrades DE")
(load "scenario difficulty DE")
(load "scenario resign")

(defrule; TC has been destroyed, pacify player
	(event-detected trigger 27)
=>
	(set-strategic-number sn-food-gatherer-percentage 60)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
	(set-strategic-number sn-wood-gatherer-percentage 40)
	(set-strategic-number sn-maximum-town-size 10)
	(set-goal 1 20)
	(set-goal 2 10)
	(disable-self)
)

(defrule
	(goal 1 20)
=>
	(delete-unit militiaman)
	(delete-unit man-at-arms)
	(delete-unit long-swordsman)
	(delete-unit two-handed-swordsman)
	(delete-unit champion)
	(delete-unit petard)
	(delete-unit spearman)
	(delete-unit pikeman)
	(delete-unit halberdier)
)

(defrule
	(goal 1 20)
=>
	(delete-unit archer)
	(delete-unit crossbowman)
	(delete-unit arbalest)
	(delete-unit skirmisher)
	(delete-unit elite-skirmisher)
	(delete-unit imperial-skirmisher)
	(delete-unit scout-cavalry)
	(delete-unit light-cavalry)
	(delete-unit hussar)
	(delete-unit knight)
)

(defrule
	(goal 1 20)
=>
	(delete-unit cavalier)
	(delete-unit paladin)
	(delete-unit my-unique-unit)
	(delete-unit galley)
	(delete-unit war-galley)
	(delete-unit galleon)
	(delete-unit cannon-galleon)
	(delete-unit fire-ship)
	(delete-unit fast-fire-ship)
	(delete-unit battering-ram)
	(delete-unit capped-ram)
	(delete-unit trebuchet)
)

(defrule
	(goal 1 20)
=>
	(delete-unit siege-ram)
	(delete-unit mangonel)
	(delete-unit onager)
	(delete-unit siege-onager)
	(delete-unit scorpion)
	(delete-unit heavy-scorpion)
	(delete-unit transport-ship)
	(delete-unit hand-cannoneer)
	(delete-unit bombard-cannon)
	(delete-unit demolition-ship)
	(delete-unit heavy-demolition-ship)
)

(defrule
	(goal 1 20)
	(military-population == 0)
	(building-type-count watch-tower-line == 0)
	(building-type-count bombard-tower == 0)
	(building-type-count castle == 0)
=>
	(set-goal 1 1)
	(disable-self)
)

; START

(defrule
	(true)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-town-size 25)
    (set-strategic-number sn-camp-max-distance 30)
    (set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(set-strategic-number sn-wall-targeting-mode 1)
	(set-goal 2 1)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-food-gatherer-percentage 40)
	(set-strategic-number sn-gold-gatherer-percentage 35)
	(set-strategic-number sn-stone-gatherer-percentage 10)
	(set-strategic-number sn-wood-gatherer-percentage 15)
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders 15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(enable-timer 4 7000)
	(disable-self)
)

; in case of long game, break glass
(defrule
	(timer-triggered 4)
	(goal 2 1)
=>
	(chat-local-to-self "I think I need some resources")
	(cc-add-resource food 400)
	(cc-add-resource wood 400)
	(cc-add-resource gold 400)
	(disable-timer 4)
	(enable-timer 4 2700)
)

(defrule
	(true)
=>
	(set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-percent-attack-soldiers 40)
	(disable-self)
)

(defrule
	(difficulty == easy)
=>
	(enable-timer 2 2850)
	(disable-self)
)

(defrule
	(difficulty == moderate)
=>
	(set-strategic-number sn-cap-civilian-builders 3)
	(enable-timer 2 2450)
	(disable-self)
)

(defrule
	(difficulty == hard)
=>
	(set-strategic-number sn-cap-civilian-builders 5)
	(enable-timer 2 1850)
	(disable-self)
)

(defrule
	(timer-triggered 2)
	(goal 2 1)
=>
	(attack-now)
	(chat-local-to-self "launching first attack")
	(enable-timer 1 300)
	(disable-timer 2)
	(disable-self)
)

(defrule
	(timer-triggered 1)
	(defend-soldier-count >= 15)
	(goal 2 1)
=>
	(attack-now)
	(chat-local-to-self "launching subsequent attack")
	(disable-timer 1)
	(enable-timer 1 520)
)

;BUILD & MAINTAIN BUILDINGS

(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 5)
	(dropsite-min-distance wood > 5)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(resource-found gold)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance gold > 7)
	(can-build mining-camp)
	(goal 2 1)
=>
	(build mining-camp)
	(chat-local-to-self "gold place")
)

(defrule
	(resource-found stone)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance stone > 7)
	(can-build mining-camp)
	(goal 2 1)
=>
	(build mining-camp)
	(chat-local-to-self "rock place")
)

; always keep a market handy!
(defrule
	(building-type-count-total market less-than 1)
	(can-build market)
=>
	(build market)
	(chat-local-to-self "market")
)

(defrule
	(building-type-count-total mill less-than 1)
	(can-build mill)
=>
	(build mill)
	(chat-local-to-self "mill")
)

(defrule
	(building-type-count-total blacksmith less-than 1)
	(can-build blacksmith)
=>
	(build blacksmith)
	(chat-local-to-self "smith")
)

(defrule
	(building-type-count-total stable less-than 1)
	(can-build stable)
	(goal 2 1)
=>
	(build stable)
	(chat-local-to-self "stable")
)

(defrule
	(building-type-count-total siege-workshop less-than 1)
	(can-build siege-workshop)
	(goal 2 1)
=>
	(build siege-workshop)
	(chat-local-to-self "siege")
)

(defrule
	(building-type-count-total university less-than 1)
	(can-build university)
	(goal 2 1)
=>
	(build university)
	(chat-local-to-self "university")
)

; villager count
(defrule
	(unit-type-count-total villager less-than 10)
	(can-train villager)
	(goal 2 10)
=>
	(train villager)
	(chat-local-to-self "civilian")
)
(defrule
	(difficulty == easy)
	(unit-type-count-total villager less-than 22)
	(can-train villager)
	(goal 2 1)
=>
	(train villager)
	(chat-local-to-self "civilian easy")
)

(defrule
	(difficulty == moderate)
	(unit-type-count-total villager less-than 35)
	(can-train villager)
	(goal 2 1)
=>
	(train villager)
	(chat-local-to-self "civilian")
)

(defrule
	(difficulty == hard)
	(unit-type-count-total villager less-than 45)
	(can-train villager)
	(goal 2 1)
=>
	(train villager)
	(chat-local-to-self "civilian")
)

;maintain housing
(defrule
	(housing-headroom less-than 4)
	(population-headroom greater-than 0)
	(can-build house)
=>
	(build house)
	(chat-local-to-self "house")
)

;construct farms

(defrule
	(idle-farm-count <= 1)
	(building-type-count-total farm less-than 22)
	(can-build farm)
=>
	(build farm)
	(chat-local-to-self "farm")
)

; ADVANCE TO IMPERIAL

;use market to advance to imperial if need be
(defrule
	(difficulty == easy)
	(game-time > 1820)
	(unit-type-count-total villager > 20)
	(current-age == castle-age)
	(goal 2 1)
=>
	(set-goal 16 99)
	(disable-self)
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total villager > 25)
	(current-age == castle-age)
	(goal 2 1)
=>
	(set-goal 16 99)
	(disable-self)
)

(defrule
(goal 16 99)
	(wood-amount greater-than 600)
	(can-sell-commodity wood)
=>
	(chat-local-to-self "selling wood for imperial gold")
	(sell-commodity wood)
)

(defrule
(goal 16 99)
	(stone-amount greater-than 500)
	(commodity-selling-price stone greater-than 50)
	(can-sell-commodity stone)
=>
	(chat-local-to-self "selling stone for imperial gold")
	(sell-commodity stone)
)

(defrule
(goal 16 99)
	(food-amount greater-or-equal 1100)
	(can-sell-commodity food)
=>
	(chat-local-to-self "selling food for imperial gold")
	(sell-commodity food)
)

;getting needed food
(defrule
	(goal 16 99)
	(gold-amount greater-or-equal 1000)
	(commodity-buying-price food less-than 200)
	(can-buy-commodity food)
=>
	(chat-local-to-self "buying imperial food")
	(buy-commodity food)
)

; advance to imperial age if possible.
(defrule
	(goal 16 99)
	(can-research-with-escrow imperial-age)
	(goal 2 1)
=>
	(release-escrow wood)
	(release-escrow food)
	(release-escrow gold)
	(release-escrow stone)
	(research imperial-age)
	(chat-local-to-self "rising to imperial")
	(set-goal 16 0)
)

;TONS O' TOWERS!

(defrule
	(building-type-count watch-tower-line < 8)
	(can-build watch-tower-line)
	(goal 2 1)
=>
	(build watch-tower-line)
	(chat-local-to-self "build tower")
)

(defrule
	(building-type-count watch-tower-line >= 5)
	(building-type-count castle < 2)
	(can-build castle)
	(goal 2 1)
=>
	(build castle)
	(chat-local-to-self "castle")
)

;MILITARY UNITS

(defrule
	(unit-type-count-total scout-cavalry-line < 1)
	(can-train scout-cavalry-line)
	(goal 2 1)
=>
	(train scout-cavalry-line)
	(chat-local-to-self " I'm scoutin! ")
)

(defrule
	(unit-type-count-total longbowman-line less-than 10)
	(can-train longbowman-line)
	(goal 2 1)
=>
	(train longbowman-line)
	(chat-local-to-self "longbowman")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total longbowman-line less-than 20)
	(can-train longbowman-line)
	(goal 2 1)
=>
	(train longbowman-line)
	(chat-local-to-self "longbowman")
)

(defrule
	(unit-type-count-total knight-line less-than 3)
	(can-train knight-line)
	(goal 2 1)
=>
	(train knight-line)
	(chat-local-to-self "knight")
)

(defrule
	(difficulty == moderate)
	(unit-type-count-total knight-line less-than 5)
	(can-train knight-line)
	(goal 2 1)
=>
	(train knight-line)
	(chat-local-to-self "knight")
)

(defrule
	(difficulty == hard)
	(unit-type-count-total knight-line less-than 7)
	(can-train knight-line)
	(goal 2 1)
=>
	(train knight-line)
	(chat-local-to-self "knight")
)

(defrule
	(difficulty == easy)
	(unit-type-count-total mangonel-line less-than 1)
	(can-train mangonel-line)
	(goal 2 1)
=>
	(train mangonel-line)
	(chat-local-to-self "mangonel")
)

(defrule
	(difficulty >= moderate)
	(unit-type-count-total mangonel-line less-than 3)
	(can-train mangonel-line)
	(goal 2 1)
=>
	(train mangonel-line)
	(chat-local-to-self "mangonel")
)

(defrule
	(difficulty < moderate)
	(unit-type-count-total mangonel-line less-than 5)
	(can-train mangonel-line)
	(goal 2 1)
=>
	(train mangonel-line)
	(chat-local-to-self "mangonel")
)

(defrule
	(difficulty == easy)
	(unit-type-count-total trebuchet-set less-than 2)
	(can-train trebuchet)
	(goal 2 1)
=>
	(train trebuchet)
	(chat-local-to-self "trebuchet")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total trebuchet-set less-than 6)
	(can-train trebuchet)
	(goal 2 1)
=>
	(train trebuchet)
	(chat-local-to-self "trebuchet")
)
