;Mongol scenario 6 Player 2
;Hungary

(load "scenario market")
(load "scenario upgrades DE")
(load "scenario difficulty DE")
(load "scenario resign FE")

(defconst gl-available-food-amount 10)
(defconst temporary-goal-food 11)
(defconst gl-available-wood-amount 12)
(defconst temporary-goal-wood 13)

(defrule
	(true)
=>
	(up-get-fact food-amount 0 gl-available-food-amount)
	(up-get-fact escrow-amount food temporary-goal-food)
	(up-modify-goal gl-available-food-amount g:- temporary-goal-food)	
	(up-get-fact wood-amount 0 gl-available-wood-amount)
	(up-get-fact escrow-amount wood temporary-goal-wood)
	(up-modify-goal gl-available-wood-amount g:- temporary-goal-wood)
)

;RELEASE ESCROW
(defrule
	(true)
=>	
	(enable-timer 9 900) ; Release escrow
	(disable-self)
)

(defrule ; don't hold on to resources
	(timer-triggered 9)
=>
	(release-escrow wood)
	(release-escrow food)
	(release-escrow gold)
	(release-escrow stone)
	(disable-timer 9)
	(enable-timer 9 600)
)

; RESIGNING

(defrule
	(event-detected trigger 99)
=>
	(resign)
	(disable-self)
)

; GROUPS

(defrule
	(true)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-town-size 40)
    (set-strategic-number sn-camp-max-distance 30)
    (set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 15)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-attack-intelligence 1)
	(set-strategic-number sn-wall-targeting-mode 1)
	(set-strategic-number sn-livestock-to-town-center 1)
	(set-strategic-number sn-intelligent-gathering 1)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(set-strategic-number sn-maximum-wood-drop-distance 20)
	(set-strategic-number sn-maximum-hunt-drop-distance 40)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders  15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-gatherers 100)
	(set-strategic-number sn-food-gatherer-percentage  40)
	(set-strategic-number sn-gold-gatherer-percentage  25)
	(set-strategic-number sn-stone-gatherer-percentage 5)
	(set-strategic-number sn-wood-gatherer-percentage  30)
	(disable-self)
)

(defrule
	(true)
=>
	(set-goal 15 40)
	(enable-timer 4 380)
	(chat-local-to-self "timer set")
	(disable-self)
)

(defrule
	(timer-triggered 4)
=>
	(set-signal 11)
	(set-strategic-number sn-percent-attack-soldiers 30)
	(attack-now)
	(disable-timer 4)
	(enable-timer 4 450)
	(enable-timer 5 5)
	(disable-self)
)

(defrule
	(goal 15 40)
	(timer-triggered 4)
	(defend-soldier-count >= 12)
=>
	(chat-local-to-self "attacking")
	(set-strategic-number sn-percent-attack-soldiers 40)
	(attack-now)
	(disable-timer 4)
	(enable-timer 4 350)
	(enable-timer 5 5)
)

(defrule
	(timer-triggered 5)
=>
	(set-strategic-number sn-task-ungrouped-soldiers 1)
	(enable-timer 6 30)
	(disable-timer 5)
)

(defrule
	(timer-triggered 6)
=>
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(disable-timer 6)
)

; ============= BLOW UP BRIDGE AND WONDER

(defrule
	(event-detected trigger 5)
=>
	(set-goal 15 98)
	(set-goal 16 98)
	(cc-add-resource food 1200)
	(cc-add-resource wood 700)
	(cc-add-resource gold 1200)
	(cc-add-resource stone 700)
	(disable-self)
)

(defrule
	(goal 15 98)
	(wood-amount greater-than 1200)
	(can-sell-commodity wood)
=>
	(chat-local-to-self "selling wood for wonder")
	(sell-commodity wood)
)

(defrule
	(goal 15 98)
	(stone-amount greater-than 1200)
	(commodity-selling-price stone greater-than 50)
	(can-sell-commodity stone)
=>
	(chat-local-to-self "selling stone for wonder")
	(sell-commodity stone)
)

(defrule
	(goal 15 98)
	(food-amount greater-or-equal 1100)
	(can-sell-commodity food)
=>
	(chat-local-to-self "selling food for wonder")
	(sell-commodity food)
)

;getting needed stone
(defrule
	(goal 15 98)
	(gold-amount greater-or-equal 4000)
	(commodity-buying-price stone less-than 200)
	(can-buy-commodity stone)
=>
	(chat-local-to-self "buying wonder stone")
	(buy-commodity food)
)

; do it

(defrule
	(goal 15 98)
	(can-build-with-escrow wonder)
=>
	(set-strategic-number sn-maximum-town-size 60)
	(release-escrow wood)
	(release-escrow food)
	(release-escrow gold)
	(release-escrow stone)
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders  100)
	(set-strategic-number sn-percent-civilian-gatherers 0)
	(set-strategic-number sn-cap-civilian-builders 5)
	(up-assign-builders c: wonder c: 5)
	(build wonder)
	(chat-local-to-self "wonder")
	(set-goal 16 0)
	(disable-self)
)

(defrule
	(building-type-count wonder > 0)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders  15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(cc-add-resource food 1000)
	(cc-add-resource wood 1000)
	(cc-add-resource gold 1000)
	(cc-add-resource stone 700)
	(set-goal 21 1)
	(disable-self)
)

; ===================== UNITS

(defrule
	(unit-type-count-total villager less-than 25)
	(difficulty == easy)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

(defrule
	(unit-type-count-total villager less-than 40)
	(difficulty == moderate)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

(defrule
	(unit-type-count-total villager less-than 50)
	(difficulty == hard)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

;maintain housing
(defrule
	(housing-headroom less-than 4)
	(population-headroom greater-than 0)
	(can-build house)
=>
	(build house)
	(chat-local-to-self "house")
)

(defrule
	(building-type-count-total archery-range less-than 1)
	(can-build archery-range)
=>
	(build archery-range)
	(chat-local-to-self "archery range")
)

(defrule
	(building-type-count-total stable less-than 1)
	(can-build stable)
=>
	(build stable)
	(chat-local-to-self "stable")
)

(defrule
	(game-time > 240)
	(building-type-count-total blacksmith less-than 1)
	(can-build blacksmith)
=>
	(build blacksmith)
	(chat-local-to-self "blacksmith")
)

(defrule
	(building-type-count-total market less-than 1)
	(can-build market)
=>
	(build market)
	(chat-local-to-self "market")
)

(defrule
	(game-time > 1200)
	(building-type-count-total siege-workshop > 1)
	(building-type-count-total siege-workshop < 3)
	(can-build siege-workshop)
=>
	(build-forward siege-workshop)
	(chat-local-to-self "forward siege workshop")
)

(defrule
	(game-time > 1200)
	(building-type-count-total stable > 1)
	(building-type-count-total stable < 3)
	(can-build stable)
=>
	(build-forward stable)
	(chat-local-to-self "forward stable")
)

(defrule
        (building-type-count-total monastery less-than 1)
        (can-build monastery)
=>
        (build monastery)
        (chat-local-to-self "monastery")
)

(defrule
	(game-time > 1200)
	(building-type-count-total farm less-than 20)
	(idle-farm-count <= 1)
	(can-build farm)
=>
	(build farm)
)

(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 5)
	(dropsite-min-distance wood > 5)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(building-type-count-total lumber-camp less-than 2)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
	(disable-self)
)

(defrule
	(resource-found gold)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance gold > 5)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "gold place")
)

(defrule
	(resource-found stone)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance stone > 5)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "rock place")
)

(defrule
	(building-type-count-total mill less-than 2)
	(can-build mill)
=>
	(build mill)
	(chat-local-to-self "mill")
	(disable-self)
)

(defrule
	(building-type-count-total mill less-than 1)
	(can-build mill)
=>
	(build mill)
	(chat-local-to-self "mill")
)

(defrule
	(building-type-count-total university less-than 1)
	(can-build university)
=>
	(build university)
	(chat-local-to-self "university")
)

; MILITARY UNITS

(defrule
	(unit-type-count-total knight-line < 10)
	(or
		(unit-type-count-total scorpion-line > 2)
		(town-under-attack)
	)
	(can-train knight-line)
=>
	(train knight-line)
	(chat-local-to-self "mo cav")
)

(defrule
	(unit-type-count-total skirmisher-line < 15)
	(unit-type-count-total trebuchet-set > 0)
	(can-train skirmisher-line)
	(up-compare-goal gl-available-food-amount > 60)
=>
	(train skirmisher-line)
	(chat-local-to-self "skirmisher")
)

(defrule
	(unit-type-count-total scout-cavalry-line < 1)
	(can-train scout-cavalry-line)
=>
	(train scout-cavalry-line)
	(chat-local-to-self "I'm scoutin'")
)

(defrule
	(unit-type-count-total scorpion-line < 2)
	(can-train scorpion-line)
	(difficulty == easy)
=>
	(train scorpion-line)
	(chat-local-to-self "scorpion")
)

(defrule
	(unit-type-count-total scorpion-line < 4)
	(can-train scorpion-line)
	(difficulty == moderate)
=>
	(train scorpion-line)
	(chat-local-to-self "scorpion")
)

(defrule
	(unit-type-count-total scorpion-line < 5)
	(can-train scorpion-line)
	(difficulty == hard)
=>
	(train scorpion-line)
	(chat-local-to-self "scorpion")
)

(defrule
	(unit-type-count-total trebuchet-set < 3)
	(can-train trebuchet)
	(game-time > 240)
=>
	(train trebuchet)
	(chat-local-to-self "trebuchet")
)

(defrule
	(not (town-under-attack))
	(unit-type-count-total trebuchet-set > 0)
	(game-time greater-than 360)
	(unit-type-count-total battering-ram-line < 4)
	(can-train battering-ram-line)
=>
	(train battering-ram-line)
	(chat-local-to-self "battering-ram")
)

(defrule
	(game-time greater-than 360)
	(unit-type-count-total monk < 2)
	(can-train monk)
=>
	(train monk)
	(chat-local-to-self "lava creature")
)

(defrule
		(unit-type-count-total my-unique-unit-line < 9)
	(or
		(unit-type-count-total scorpion-line > 2)
		(town-under-attack)
	)
	(can-train my-unique-unit-line)
=>
	(train my-unique-unit-line)
	(chat-local-to-self "Huszar")
)

(defrule
	(town-under-attack)
	(unit-type-count-total scout-cavalry-line < 8)
	(can-train scout-cavalry-line)
=>
	(train scout-cavalry-line)
	(chat-local-to-self "I'm defending")
)

;EXTRA RESSOURCES FINAL

(defrule
	(building-type-count-total castle less-than 2)
=>
	(cc-add-resource food 1200)
	(cc-add-resource wood 900)
	(cc-add-resource gold 800)
	(disable-self)
)

(defrule
	(building-type-count-total castle less-than 1)
=>
	(cc-add-resource food 800)
	(cc-add-resource wood 700)
	(cc-add-resource gold 800)
	(disable-self)
)

