;Attila scenario 1 Player 3
;Scythians

(load "scenario market")
(load "scenario upgrades DE")
(load "scenario difficulty DE")
(load "scenario resign")

; needs ships, knights, cavalry archers, siege, mangudai

; RESIGNING
(defrule
	(building-type-count town-center less-than 1)
	(unit-type-count-total villager < 5)	
=>
	(set-goal 1 19)
	(disable-self)
)

(defrule
	(event-detected trigger 97)
	(or
		(players-stance 1 enemy)
		(players-stance 1 neutral)
	)

=>
	(acknowledge-event trigger 97)
	(set-stance 1 enemy)
	(cc-add-resource food 300)
	(cc-add-resource wood 700)
	(cc-add-resource gold 700)
	(cc-add-resource stone 100)
	(set-signal 5)
	(disable-self)
)


(defrule
	(not (player-in-game 4))
	(not (player-in-game 5))
=>
	(chat-local-to-self "I'm LONELY!")
	;(resign)
	(disable-self)
)

; GROUPS

(defrule
	(true)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-town-size 25)
    (set-strategic-number sn-camp-max-distance 30)
    (set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(set-strategic-number sn-number-explore-groups 0)
	(enable-timer 3 1)
	(enable-timer 4 300)
	(disable-self)
)

(defrule
	(game-time > 920)
=>
	(set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-task-ungrouped-soldiers 1)	
	(enable-timer 6 5)
	(disable-self)
)

(defrule
	(timer-triggered 6)
=>
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(disable-timer 6)
	(enable-timer 7 220)
)

(defrule
	(timer-triggered 7)
=>
	(set-strategic-number sn-task-ungrouped-soldiers 1)
	(disable-timer 7)
	(enable-timer 6 5)
)

(defrule
	(event-detected trigger 97)
	(not (timer-triggered 3))
	(building-type-count market > 0)
	(taunt-detected 1 38)
=>
	(chat-to-player-using-id 1 22118)
	(acknowledge-taunt 1 38)
)	

(defrule
	(event-detected trigger 97)
	(building-type-count market less-than 1)
	(taunt-detected 1 38)
=>
	(chat-to-player-using-id 1 22164)
	(acknowledge-taunt 1 38)
)	

(defrule
	(event-detected trigger 97)
	(timer-triggered 3)
	(taunt-detected 1 38)
	(building-type-count market > 0)
=>
	(tribute-to-player 1 gold 200)
	(tribute-to-player 1 food 300)
	(tribute-to-player 1 wood 200)
	(disable-timer 3)
	(enable-timer 3 120)
	(acknowledge-taunt 1 38)
)	

(defrule
	(defend-soldier-count >= 10)
	(event-detected trigger 10)
	(game-time > 2000)
=>
	(set-strategic-number sn-percent-attack-soldiers 70)
	(attack-now)
	(enable-timer 1 600)
	(chat-local-to-self "Bleda dies so time to attack")
	(disable-self)
)

(defrule
	(difficulty == standard)
	(defend-soldier-count >= 10)
	(timer-triggered 1)
=>
	(attack-now)
	(disable-timer 1)
	(chat-local-to-self "Attack every 600!!!")
	(enable-timer 1 600)
)

(defrule
	(difficulty <= moderate)
	(defend-soldier-count >= 10)
	(timer-triggered 1)
=>
	(attack-now)
	(disable-timer 1)
	(chat-local-to-self "Attack every 300!!!")
	(enable-timer 1 300)
)

(defrule
	(event-detected trigger 97)
	(timer-triggered 4)
	(taunt-detected 1 31)
=>
	(disable-timer 4)
	(enable-timer 4 300)
	(disable-timer 1)
	(enable-timer 1 600)
	(acknowledge-taunt 1 31)
	(chat-to-player-using-id 1 22117)
	(attack-now)
)	

(defrule
	(event-detected trigger 97)
	(not(timer-triggered 4))
	(taunt-detected 1 31)
=>
	(chat-to-player-using-id 1 22118)
	(acknowledge-taunt 1 31)
)	

;VILLAGERS

(defrule
	(true)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders  15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(set-strategic-number sn-cap-civilian-explorers 2)
	(set-strategic-number sn-minimum-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-gatherers 100)
	(set-strategic-number sn-food-gatherer-percentage  33)
	(set-strategic-number sn-gold-gatherer-percentage  33)
	(set-strategic-number sn-stone-gatherer-percentage 0)
	(set-strategic-number sn-wood-gatherer-percentage  33)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(set-strategic-number sn-maximum-wood-drop-distance 20)
	(disable-self)
)

;BUILDING UNITS
(defrule
	(difficulty <= moderate)	
	(unit-type-count-total villager < 40)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

(defrule
	(difficulty == easy)	
	(unit-type-count-total villager < 20)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)


;maintain housing
(defrule
	(housing-headroom less-than 4)
	(population-headroom greater-than 0)
	(can-build house)
=>
	(build house)
	(chat-local-to-self "house")
)

;maintain a town center
(defrule
	(building-type-count town-center less-than 1)
	(can-build town-center)
=>
	(build town-center)
)

(defrule
	(building-type-count-total archery-range less-than 2)
	(can-build archery-range)
=>
	(build archery-range)
	(chat-local-to-self "archery range")
)

(defrule
	(building-type-count-total blacksmith less-than 1)
	(can-build blacksmith)
=>
	(build blacksmith)
	(chat-local-to-self "blacksmith")
)

(defrule
	(building-type-count-total market less-than 1)
	(can-build market)
=>
	(build market)
	(chat-local-to-self "market")
)

;Siege Workshop & maintain it
(defrule
	(building-type-count-total siege-workshop less-than 1)
	(can-build siege-workshop)
=>
	(build siege-workshop)
	(chat-local-to-self "siege workshop")
)

(defrule
	(difficulty == easy)	
	(idle-farm-count <= 1)
	(game-time greater-than 300)
	(building-type-count-total farm less-than 7)
	(can-build farm)
=>
	(build farm)
)

(defrule
	(difficulty <= moderate)	
	(idle-farm-count <= 1)
	(game-time greater-than 300)
	(building-type-count-total farm less-than 13)
	(can-build farm)
=>
	(build farm)
)

(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 5)
	(dropsite-min-distance wood > 5)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(resource-found gold)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance gold > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "gold place")
)

(defrule
	(resource-found stone)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance stone > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "rock place")
)

(defrule
	(building-type-count-total mill less-than 1)
=>
	(build mill)
	(chat-local-to-self "mill")
)

(defrule
	(building-type-count-total university less-than 1)
	(can-build university)
=>
	(build university)
	(chat-local-to-self "university")
)

; ================= CASTLE AGE

(defrule
	(unit-type-count-total villager > 16)
	(current-age == feudal-age)
=>
	(set-goal 16 98)
	(disable-self)
)

(defrule
(goal 16 98)
	(wood-amount greater-than 600)
	(can-sell-commodity wood)
=>
	(chat-local-to-self "selling wood for castle gold")
	(sell-commodity wood)
)

(defrule
(goal 16 98)
	(stone-amount greater-than 500)
	(commodity-selling-price stone greater-than 50)
	(can-sell-commodity stone)
=>
	(chat-local-to-self "selling stone for castle gold")
	(sell-commodity stone)
)

(defrule
(goal 16 98)
	(food-amount greater-or-equal 1100)
	(can-sell-commodity food)
=>
	(chat-local-to-self "selling food for castle gold")
	(sell-commodity food)
)

;getting needed food
(defrule
(goal 16 98)
	(gold-amount greater-or-equal 1000)
	(commodity-buying-price food less-than 200)
	(can-buy-commodity food)
=>
	(chat-local-to-self "buying castle food")
	(buy-commodity food)
)

; advance to castle age if possible.
(defrule
	(goal 16 98)
	(can-research-with-escrow castle-age)
=>
	(release-escrow wood)
	(release-escrow food)
	(release-escrow gold)
	(release-escrow stone)
	(research castle-age)
	(chat-local-to-self "rising to castle")
	(set-goal 16 0)
)

; MILITARY UNITS

(defrule
	(difficulty == easy)
	(unit-type-count-total cavalry-archer-line < 12)
	(can-train cavalry-archer-line)
=>
	(train cavalry-archer-line)
	(chat-local-to-self "cavalry-archer-line")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total cavalry-archer-line < 17)
	(can-train cavalry-archer-line)
=>
	(train cavalry-archer-line)
	(chat-local-to-self "cavalry-archer-line")
)


(defrule
	(difficulty == easy)
	(unit-type-count-total my-unique-unit < 8)
	(can-train my-unique-unit)
=>
	(train my-unique-unit)
	(chat-local-to-self "mangudai")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total my-unique-unit < 14)
	(can-train my-unique-unit)
=>
	(train my-unique-unit)
	(chat-local-to-self "mangudai")
)

