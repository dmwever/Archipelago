;joan scn6 player4
;Shrewsbury

(load "scenario market")
(load "scenario upgrades DE")
(load "scenario difficulty DE")
(load "scenario resign")

(defrule
	(building-type-count wonder < 1)
	(military-population < 6)
	(unit-type-count-total villager < 3)
	(not (can-train villager) )
=>
	(set-goal 1 19)
	(disable-self)
)

(defrule
	(true)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-town-size 25)
    (set-strategic-number sn-camp-max-distance 30)
    (set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-task-ungrouped-soldiers 1)
	(set-strategic-number sn-wall-targeting-mode 1)
	(enable-timer 4 3600)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-percent-civilian-explorers 20)
	(set-strategic-number sn-percent-civilian-builders 15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-gatherers 100)
	(set-strategic-number sn-food-gatherer-percentage  40)
	(set-strategic-number sn-gold-gatherer-percentage  35)
	(set-strategic-number sn-stone-gatherer-percentage 5)
	(set-strategic-number sn-wood-gatherer-percentage  20)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(set-strategic-number sn-maximum-wood-drop-distance 20)
	(disable-self)
)

; in case of long game, break glass
(defrule
	(timer-triggered 4)
=>
	(cc-add-resource food 700)
	(cc-add-resource wood 700)
	(cc-add-resource gold 700)
	(disable-timer 4)
	(enable-timer 4 600)
)

(defrule
	(difficulty == easy)
=>
	(set-strategic-number sn-percent-attack-soldiers 70)
	(set-strategic-number sn-number-explore-groups 1)
	(enable-timer 1 1200)
	(disable-self)
)

(defrule
	(difficulty <= moderate)
=>
	(set-strategic-number sn-percent-attack-soldiers 80)
	(set-strategic-number sn-number-explore-groups 1)
	(enable-timer 1 300)
	(disable-self)
)

(defrule
	(timer-triggered 1)
	(defend-soldier-count >= 16)
=>
	(disable-timer 1)
	(enable-timer 1 520)
	(attack-now)
)

; villager count
(defrule
	(difficulty == easy)
	(unit-type-count-total villager less-than 20)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "civilian easy")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total villager less-than 45)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "civilian")
)

;maintain housing
(defrule
	(housing-headroom less-than 4)
	(population-headroom greater-than 0)
	(can-build house)
=>
	(build house)
	(chat-local-to-self "house")
)

;maintain a town center
(defrule
	(game-time greater-than 45)
	(building-type-count town-center less-than 2)
	(can-build town-center)
=>
	(build town-center)
)

; but construct a mill no matter what & maintain said mill
(defrule
	(game-time greater-than 90)
	(building-type-count-total mill less-than 1)
	(can-build mill)
=>
	(build mill)
	(chat-local-to-self "mill")
)

(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 4)
	(dropsite-min-distance wood > 5)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(resource-found gold)
	(building-type-count-total mining-camp < 4)
	(dropsite-min-distance gold > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "gold place")
)

(defrule
	(resource-found stone)
	(building-type-count-total mining-camp < 4)
	(dropsite-min-distance stone > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "rock place")
)

(defrule
	(idle-farm-count <= 1)
	(building-type-count-total farm less-than 20)
	(can-build farm)
=>
	(build farm)
)

(defrule
	(building-type-count-total market less-than 1)
	(can-build market)
=>
	(build market)
	(chat-local-to-self "market")
)

;get a blacksmith
(defrule
	(building-type-count-total market greater-than 0)
	(building-type-count-total blacksmith less-than 1)
	(can-build blacksmith)
=>
	(build blacksmith)
	(chat-local-to-self "blacksmith")
)

(defrule
	(building-type-count-total stable < 2)
	(can-build stable)
=>
	(build stable)
	(chat-local-to-self "stable")
)

(defrule
	(building-type-count-total stable > 0)
	(building-type-count-total stable < 4)
	(can-build stable)
=>
	(build-forward stable)
	(chat-local-to-self "forward stable")
	(disable-self)
)

;University & maintain it
(defrule
	(building-type-count-total university less-than 1)
	(can-build university)
=>
	(build university)
	(chat-local-to-self "university")
)

;Siege Workshop & maintain it
(defrule
	(building-type-count-total siege-workshop less-than 2)
	(can-build siege-workshop)
=>
	(build siege-workshop)
	(chat-local-to-self "siege workshop")
)

(defrule
	(unit-type-count-total knight-line < 20)
	(can-train knight-line)
=>
	(train knight-line)
	(chat-local-to-self "knight")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total knight-line < 40)
	(can-train knight-line)
=>
	(train knight-line)
	(chat-local-to-self "knight")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total trebuchet-set < 4)
	(can-train trebuchet)
=>
	(train trebuchet)
	(chat-local-to-self "tebuchet")
)

(defrule
	(unit-type-count-total scout-cavalry-line < 12)
	(can-train scout-cavalry-line)
=>
	(train scout-cavalry-line)
	(chat-local-to-self "light cav")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total scout-cavalry-line < 30)
	(can-train scout-cavalry-line)
=>
	(train scout-cavalry-line)
	(chat-local-to-self "light cav")
)

(defrule
	(not (town-under-attack))
	(unit-type-count-total battering-ram-line < 6)
	(can-train battering-ram-line)
=>
	(train battering-ram-line)
	(chat-local-to-self "battering ram")
)


