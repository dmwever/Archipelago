;this ai is for Castillon
; Red English in city

(load "scenario market")
(load "scenario upgrades DE")
(load "scenario difficulty DE")


(defrule
	(true)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-town-size 25)
    (set-strategic-number sn-camp-max-distance 30)
    (set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(set-strategic-number sn-wall-targeting-mode 1)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-minimum-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders 15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-food-gatherer-percentage 40)
	(set-strategic-number sn-gold-gatherer-percentage 25)
	(set-strategic-number sn-stone-gatherer-percentage 5)
	(set-strategic-number sn-wood-gatherer-percentage 30)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(set-strategic-number sn-maximum-wood-drop-distance 20)
	(enable-timer 4 2700) ; Cheat timer
	(disable-self)
)

; in case of long game, break glass
(defrule
	(timer-triggered 4)
=>
	(cc-add-resource food 700)
	(cc-add-resource wood 700)
	(cc-add-resource gold 700)
	(disable-timer 4)
	(enable-timer 4 600)
)

(defrule
	(true)
=>
	(set-strategic-number sn-number-explore-groups 1)
	(disable-self)
)

(defrule
	(difficulty == easy)
	(event-detected trigger 1)
	(game-time > 2100)
=>
	(set-strategic-number sn-percent-attack-soldiers 20)
	(chat-local-to-self "attacking now")
	(set-signal 30)
	(attack-now)
	(enable-timer 1 920)
	(disable-self)
)

(defrule
	(difficulty == moderate)
	(event-detected trigger 1)
	(game-time > 1700)
=>
	(set-strategic-number sn-percent-attack-soldiers 25)
	(chat-local-to-self "attacking now")
	(set-signal 30)
	(attack-now)
	(enable-timer 1 920)
	(disable-self)
)

(defrule
	(difficulty == hard)
	(event-detected trigger 1)
	(game-time > 1400)
=>
	(set-strategic-number sn-percent-attack-soldiers 30)
	(chat-local-to-self "attacking now")
	(set-signal 30)
	(attack-now)
	(enable-timer 1 920)
	(disable-self)
)

(defrule
	(timer-triggered 1)
	(defend-soldier-count >= 12)
	(defend-soldier-count < 24)
=>
	(set-strategic-number sn-percent-attack-soldiers 40)
	(chat-local-to-self "attacking now")
	(attack-now)
	(disable-timer 1)
	(enable-timer 1 420)
)

(defrule
	(timer-triggered 1)
	(defend-soldier-count >= 24)
=>
	(set-strategic-number sn-percent-attack-soldiers 20)
	(chat-local-to-self "attacking now")
	(attack-now)
	(disable-timer 1)
	(enable-timer 1 420)
)

; villager count
(defrule
	(difficulty == easy)
	(unit-type-count-total villager less-than 21)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "civilian easy")
)

(defrule
	(difficulty == moderate)
	(unit-type-count-total villager less-than 30)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "civilian moderate")
)

(defrule
	(difficulty == hard)
	(unit-type-count-total villager less-than 40)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "civilian")
)

;maintain housing
(defrule
	(housing-headroom less-than 4)
	(population-headroom greater-than 0)
	(can-build house)
=>
	(build house)
	(chat-local-to-self "house")
)

;maintain a town center
(defrule
	(game-time < 3600)
	(building-type-count town-center less-than 1)
	(can-build town-center)
=>
	(build town-center)
)

(defrule
	(building-type-count castle less-than 2)
	(can-build castle)
=>
	(build castle)
)

(defrule
	(building-type-count-total mill less-than 1)
	(can-build mill)
=>
	(build mill)
)

;construct farms

(defrule
	(idle-farm-count <= 1)
	(building-type-count-total farm less-than 26)
	(can-build farm)
=>
	(build farm)
)

(defrule
	(resource-found wood)
	(dropsite-min-distance wood > 5)
	(building-type-count-total lumber-camp < 4)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(resource-found gold)
	(dropsite-min-distance gold > 7)
	(building-type-count-total mining-camp < 4)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "gold place")
)

(defrule
	(resource-found stone)
	(dropsite-min-distance stone > 7)
	(building-type-count-total mining-camp < 4)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "rock place")
)

;make stables
(defrule
	(building-type-count-total stable less-than 3)
	(can-build stable)
=>
	(build stable)
	(chat-local-to-self "stable")
)

(defrule
	(building-type-count-total market less-than 1)
	(can-build market)
=>
	(build market)
	(chat-local-to-self "market")
)

(defrule
	(building-type-count-total blacksmith less-than 1)
	(can-build blacksmith)
=>
	(build blacksmith)
	(chat-local-to-self "blacksmith")
)

;University & maintain it
(defrule
	(building-type-count-total university less-than 1)
	(can-build university)
=>
	(build university)
	(chat-local-to-self "university")
	(disable-self)
)

(defrule
	(building-type-count-total siege-workshop less-than 1)
	(can-build siege-workshop)
=>
	(build siege-workshop)
	(chat-local-to-self "siege workshop")
	(disable-self)
)

(defrule
	(building-type-count dock less-than 1)
	(can-build dock)
=>
	(build dock)
)

;MILITARY

(defrule
	(unit-type-count-total longbowman-line < 12)
	(can-train longbowman-line)
=>
	(train longbowman-line)
	(chat-local-to-self "I'm not English, I'm Welsh")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total longbowman-line < 25)
	(can-train longbowman-line)
=>
	(train longbowman-line)
	(chat-local-to-self "I'm not English, I'm Welsh")
)

