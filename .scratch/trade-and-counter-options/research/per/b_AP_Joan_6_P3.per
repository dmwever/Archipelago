(defrule
	(unit-type-count-total trebuchet-set < 2)
	(can-train trebuchet)
=>
	(train trebuchet)
	(chat-local-to-self "trebuchet")
)

(defrule
	(difficulty == hard)
	(unit-type-count-total trebuchet-set < 6)
	(can-train trebuchet)
=>
	(train trebuchet)
	(chat-local-to-self "trebuchet")
)

