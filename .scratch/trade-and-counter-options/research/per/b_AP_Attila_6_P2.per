;Attila scn 6 player 3 (Aquileia - red Byzantines)

(load "scenario difficulty DE")
(load "scenario resign")
(load "scenario upgrades DE")
(load "scenario market")

; RESIGNING
(defrule
	(or
		(and
			(event-detected trigger 6)
			(and
				(building-type-count wonder less-than 1)
				(building-type-count town-center less-than 1)
			)
		)
		(and
			(not(event-detected trigger 6))
			(and
				(building-type-count town-center less-than 1)
				(unit-type-count villager less-than 2)
			)
		)
	)
=>
	(set-goal 1 19)
	(set-signal 1)
	(disable-self)
)

(defrule
	(true)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-town-size 25)
    (set-strategic-number sn-camp-max-distance 30)
    (set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-percent-attack-soldiers 50)
	(set-strategic-number sn-number-explore-groups 1)
	(disable-self)
)

 (defrule
	(true)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders 15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(set-strategic-number sn-food-gatherer-percentage  50)
	(set-strategic-number sn-gold-gatherer-percentage  0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
	(set-strategic-number sn-wood-gatherer-percentage  50)
	(enable-timer 4 600)
	(enable-timer 1 800)
	(disable-self)
)

(defrule
	(timer-triggered 1)
=>
	(chat-local-to-self "attack")
	(attack-now)
	(disable-timer 1)
	(enable-timer 1 1300)
)

; SELF- TRIB LOTS OF RESOURCES EVERY FEW MINUTES

(defrule
	(timer-triggered 4)
=>
	(chat-local-to-self "I think I need some resources")
	(cc-add-resource food 400)
	(cc-add-resource wood 400)
	(cc-add-resource gold 400)
	(cc-add-resource stone 400)
	(disable-timer 4)
	(enable-timer 4 300)
)

(defrule
	(event-detected trigger 6)
	(difficulty == easy)
=>
	(set-strategic-number sn-percent-civilian-builders 100)
	(set-strategic-number sn-percent-civilian-gatherers 0)
	(set-strategic-number sn-cap-civilian-builders 5)
	(disable-self)
)

(defrule
	(event-detected trigger 6)
	(difficulty == moderate)
=>
	(set-strategic-number sn-percent-civilian-builders 100)
	(set-strategic-number sn-percent-civilian-gatherers 0)
	(set-strategic-number sn-cap-civilian-builders 10)
	(disable-self)
)

(defrule
	(event-detected trigger 6)
	(difficulty == hard)
=>
	(set-strategic-number sn-percent-civilian-builders 100)
	(set-strategic-number sn-percent-civilian-gatherers 0)
	(set-strategic-number sn-cap-civilian-builders 20)
	(disable-self)
)

; villager count
(defrule
	(unit-type-count-total villager less-than 15)
	(can-train villager)
=>
	(train villager)
)

(defrule
	(event-detected trigger 6)
	(unit-type-count-total villager less-than 30)
	(can-train villager)
=>
	(train villager)
)

(defrule	
	(idle-farm-count <= 1)
	(game-time greater-than 300)
	(building-type-count-total farm less-than 15)
	(can-build farm)
=>
	(build farm)
)

(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 5)
	(dropsite-min-distance wood > 5)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(building-type-count-total mill less-than 1)
	(can-build mill)
=>
	(build mill)
	(chat-local-to-self "mill")
)


;MILITARY

(defrule
	(difficulty == easy)
	(unit-type-count-total knight-line < 6)
	(can-train knight-line)
=>
	(train knight-line)
	(chat-local-to-self "knight")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total knight-line < 16)
	(can-train knight-line)
=>
	(train knight-line)
	(chat-local-to-self "knight")
)

(defrule
	(difficulty == easy)
	(unit-type-count-total scout-cavalry-line < 6)
	(can-train scout-cavalry-line)
=>
	(train scout-cavalry-line)
	(chat-local-to-self "scout")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total scout-cavalry-line < 16)
	(can-train scout-cavalry-line)
=>
	(train scout-cavalry-line)
	(chat-local-to-self "scout")
)

(defrule
	(unit-type-count-total scorpion-line < 3)
	(can-train scorpion-line)
=>
	(train scorpion-line)
	(chat-local-to-self "scorpion")
)

(defrule
	(difficulty == easy)
	(unit-type-count-total spearman-line < 12)
	(can-train spearman-line)
=>
	(train spearman-line)
	(chat-local-to-self "spearman")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total spearman-line < 25)
	(can-train spearman-line)
=>
	(train spearman-line)
	(chat-local-to-self "spearman")
)

(defrule
    (cc-players-building-type-count 1 dock greater-than 0)
	(unit-type-count-total galley-line < 5)
	(can-train galley-line)
=>
	(train galley-line)
	(chat-local-to-self "galley")
)


