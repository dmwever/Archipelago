;Joan of Arc scenario 6 player 2
; Burgundy - Purple

(load "scenario market")
(load "scenario upgrades DE")
(load "scenario difficulty DE")
(load "scenario resign")

(defrule
	(event-detected trigger 3)
=>
	(set-goal 1 19)
	(disable-self)
)

(defrule
	(true)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-town-size 25)
    (set-strategic-number sn-camp-max-distance 30)
    (set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-wall-targeting-mode 1)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(set-strategic-number sn-number-explore-groups 1)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders  15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(set-strategic-number sn-cap-civilian-explorers 1)
	(set-strategic-number sn-minimum-civilian-explorers 1)
	(set-strategic-number sn-cap-civilian-gatherers 100)
	(set-strategic-number sn-food-gatherer-percentage  35)
	(set-strategic-number sn-gold-gatherer-percentage  30)
	(set-strategic-number sn-stone-gatherer-percentage 5)
	(set-strategic-number sn-wood-gatherer-percentage  30)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(set-strategic-number sn-maximum-wood-drop-distance 20)
	(disable-self)
)

(defrule
	(event-detected trigger 1)
=>
	(set-strategic-number sn-percent-attack-soldiers 50)
	(attack-now)
	(enable-timer 1 640)
	(disable-self)
)

(defrule
	(timer-triggered 1)
	(defend-soldier-count > 12)
=>
	(set-strategic-number sn-percent-attack-soldiers 70)
	(attack-now)
	(disable-timer 1)
	(enable-timer 1 440)
)

;maintain housing
(defrule
	(housing-headroom less-than 4)
	(population-headroom greater-than 0)
	(can-build house)
=>
	(build house)
	(chat-local-to-self "house")
)

;maintain a town center
(defrule
	(building-type-count town-center less-than 1)
	(can-build town-center)
=>
	(build town-center)
)

; villager count
(defrule
	(difficulty == easy)
	(unit-type-count-total villager less-than 20)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "civilian easy")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total villager less-than 45)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "civilian")
)

(defrule
	(event-detected trigger 1)
=>
	(set-strategic-number sn-number-forward-builders  2)
	(set-strategic-number sn-task-ungrouped-soldiers 1)
	(disable-self)
)

;maintain needed buildings

(defrule
	(building-type-count-total mill less-than 1)
	(can-build mill)
=>
	(build mill)
)

(defrule
	(building-type-count-total dock less-than 1)
	(can-build dock)
=>
	(build dock)
)

(defrule
    (building-type-count-total monastery less-than 1)
    (can-build monastery)
=>
    (build monastery)
)

(defrule
	(building-type-count-total market less-than 1)
	(can-build market)
=>
	(build market)
)

(defrule
	(building-type-count-total barracks less-than 2)
	(can-build barracks)
=>
	(build barracks)
)

(defrule
	(building-type-count-total blacksmith less-than 1)
	(can-build blacksmith)
=>
	(build blacksmith)
)

(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 5)
	(dropsite-min-distance wood > 5)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(resource-found gold)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance gold > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "gold place")
)

(defrule
	(resource-found stone)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance stone > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "rock place")
)

;construct farms

(defrule
	(building-type-count-total farm less-than 19)
	(idle-farm-count <= 1)
	(can-build farm)
=>
	(build farm)
)

(defrule
	(event-detected trigger 1)
	(building-type-count-total barracks == 2)
	(building-type-count-total barracks < 3)
	(can-build barracks)
=>
	(build-forward barracks)
)

;units
(defrule
	(event-detected trigger 1)
	(unit-type-count-total militiaman-line < 30)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "linebacker")
)

(defrule
	(difficulty <= moderate)
	(event-detected trigger 1)
	(unit-type-count-total militiaman-line < 50)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "linebacker")
)

(defrule
	(event-detected trigger 1)
	(unit-type-count-total spearman-line < 25)
	(can-train spearman-line)
=>
	(train spearman-line)
	(chat-local-to-self "transpear")
)

(defrule
	(difficulty <= moderate)
	(event-detected trigger 1)
	(unit-type-count-total spearman-line < 35)
	(can-train spearman-line)
=>
	(train spearman-line)
	(chat-local-to-self "transpear")
)

(defrule
	(event-detected trigger 1)
	(unit-type-count-total monk < 1)
	(can-train monk)
=>
	(train monk)
	(chat-local-to-self "transmonk")
)

(defrule
	(difficulty <= moderate)
	(event-detected trigger 1)
	(unit-type-count-total monk < 3)
	(can-train monk)
=>
	(train monk)
	(chat-local-to-self "transmonk")
)


