;Mongols scenario 5 Player 3
;Bohemia

(load "scenario market")
(load "scenario upgrades DE")
(load "scenario difficulty DE")

; GROUPS

(defrule
	(true)
=>
	(set-strategic-number sn-maximum-town-size 25)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(set-strategic-number sn-wall-targeting-mode 1)
	(disable-self)
)

(defrule
	(event-detected trigger 1)
=>
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 250)
)

(defrule
	(event-detected trigger 2)
=>
	(set-strategic-number sn-percent-attack-soldiers 100)
	(attack-now)
	(disable-self)
)


;ATTACKING

(defrule
	(event-detected trigger 2)
=>
	(enable-timer 1 60)
	(disable-self)
)


(defrule
	(timer-triggered 1)
=>
	(set-strategic-number sn-percent-attack-soldiers 100)
	(attack-now)
	(disable-timer 1)
	(enable-timer 1 100)
)

;Resign
(defrule
	(event-detected trigger 252)
	(building-type-count-total town-center < 1)
	(building-type-count-total castle < 1)
	(military-population < 5)
=>
	(resign)
	(delete-building town-center)
	(delete-unit villager)
	(delete-building barracks)
	(delete-building archery-range)
	(delete-building stable)
	(delete-building siege-workshop)
	(delete-building castle)
	(delete-building dock)
	(delete-building watch-tower)
	(delete-building guard-tower)
	(delete-building keep)
	(delete-building bombard-tower)
	(delete-unit trade-cog)
	(delete-unit trade-cart)
	(disable-self)
)

; === EASY MODE ===

(defrule
	(difficulty == normal)
=>
(set-signal 201)
(disable-self)
)

; === HARD MODE ===

(defrule
	(difficulty == hard)
=>
(set-signal 202)
(disable-self)
)