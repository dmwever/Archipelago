;Joan of Arc scenario 2 Player3
;Northern English

(load "scenario market")
(load "scenario upgrades DE")
(load "scenario difficulty DE")
(load "scenario resign")

(defconst cathedral 599)

; resign
(defrule
	(event-detected trigger 30) ;Signal to resign
=>
	(set-goal 1 19) ;Goal to resign
	(disable-self)
)

(defrule
	(not (player-in-game 7))
=>
	(set-goal 1 19) ;Goal to resign
	(disable-self)
)


; attack cathedral
(defrule
	(event-detected trigger 19)
=>
	(set-strategic-number sn-special-attack-type1 cathedral)
	(disable-self)
)

(defrule
	(true)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-town-size 25)
    (set-strategic-number sn-camp-max-distance 30)
    (set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(set-strategic-number sn-wall-targeting-mode 1)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders 15)
	(set-strategic-number sn-percent-civilian-gatherers 85)
	(set-strategic-number sn-cap-civilian-gatherers 100)
	(set-strategic-number sn-food-gatherer-percentage  35)
	(set-strategic-number sn-gold-gatherer-percentage  30)
	(set-strategic-number sn-stone-gatherer-percentage 5)
	(set-strategic-number sn-wood-gatherer-percentage  30)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-percent-attack-soldiers 50)
	(disable-self)
)

(defrule
	(defend-soldier-count >= 6)
	(or
        (cc-players-unit-type-count 1 villager greater-than 12)
		(game-time greater-than 1100)
	)
=>
	(set-strategic-number sn-task-ungrouped-soldiers 1)
	(attack-now)
	(enable-timer 2 300)
	(disable-self)
)

(defrule
	(timer-triggered 2)
=>
	(attack-now)
	(disable-timer 2)
	(enable-timer 2 300)
)

;maintain housing
(defrule
	(housing-headroom less-than 4)
	(population-headroom greater-than 0)
	(can-build house)
=>
	(build house)
	(chat-local-to-self "house")
)

;maintain a town center
(defrule
	(game-time greater-than 45)
	(building-type-count town-center less-than 1)
	(can-build town-center)
=>
	(build town-center)
)

;villager count
(defrule
	(difficulty == easy)
	(unit-type-count-total villager less-than 15)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

(defrule
	(difficulty == moderate)
	(unit-type-count-total villager less-than 25)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

(defrule
	(difficulty == hard)
	(unit-type-count-total villager less-than 35)
	(can-train villager)
=>
	(train villager)
	(chat-local-to-self "villager")
)

;maintain needed buildings
(defrule
	(building-type-count-total market less-than 1)
	(can-build market)
=>
	(build market)
)

(defrule
	(building-type-count-total mill less-than 1)
	(can-build mill)
=>
	(build mill)
)

(defrule
	(building-type-count-total barracks less-than 1)
	(can-build barracks)
=>
	(build barracks)
)

(defrule
	(building-type-count-total blacksmith less-than 1)
	(can-build blacksmith)
=>
	(build blacksmith)
)

(defrule
	(building-type-count-total siege-workshop less-than 2)
	(can-build siege-workshop)
=>
	(build siege-workshop)
)

(defrule
	(building-type-count-total university less-than 1)
	(can-build university)
=>
	(build university)
)

(defrule
        (building-type-count-total monastery less-than 1)
        (can-build monastery)
=>
        (build monastery)
)

(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 5)
	(dropsite-min-distance wood > 3)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(resource-found gold)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance gold > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "gold place")
)

(defrule
	(resource-found stone)
	(building-type-count-total mining-camp < 5)
	(dropsite-min-distance stone > 7)
	(can-build mining-camp)
=>
	(build mining-camp)
	(chat-local-to-self "rock place")
)

;construct farms if food gets short.

(defrule
	(building-type-count-total farm less-than 10)
	(can-build farm)
=>
	(build farm)
)

(defrule
	(food-amount less-than 300)
	(building-type-count-total farm less-than 15)
	(can-build farm)
=>
	(build farm)
)

;units
(defrule
	(unit-type-count-total longbowman-line < 6)
	(difficulty == easy)
	(can-train longbowman-line)
=>
	(train longbowman-line)
	(chat-local-to-self "bow dude")
)

(defrule
	(unit-type-count-total longbowman-line < 12)
	(difficulty == moderate)
	(can-train longbowman-line)
=>
	(train longbowman-line)
	(chat-local-to-self "bow dude")
)

(defrule
	(unit-type-count-total longbowman-line < 20)
	(difficulty == hard)
	(can-train longbowman-line)
=>
	(train longbowman-line)
	(chat-local-to-self "bow dude")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total monk less-than 1)
	(can-train monk)
=>
	(train monk)
	(chat-local-to-self "Howdy, I'm a monk!")
)

(defrule
	(unit-type-count-total militiaman-line < 9)
	(difficulty == easy)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "swordsman")
)

(defrule
	(unit-type-count-total militiaman-line < 14)
	(difficulty == moderate)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "swordsman")
)

(defrule
	(unit-type-count-total militiaman-line < 18)
	(difficulty == hard)
	(can-train militiaman-line)
=>
	(train militiaman-line)
	(chat-local-to-self "swordsman")
)

(defrule
	(game-time < 2400)
	(difficulty == moderate)
	(unit-type-count-total mangonel-line < 2)
	(can-train mangonel-line)
=>
	(train mangonel-line)
	(chat-local-to-self "mangoscrew")
)

(defrule
	(difficulty == hard)
	(game-time < 2400)
	(unit-type-count-total mangonel-line < 3)
	(can-train mangonel-line)
=>
	(train mangonel-line)
	(chat-local-to-self "mangoscrew")
)