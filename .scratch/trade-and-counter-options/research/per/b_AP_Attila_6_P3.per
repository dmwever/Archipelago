;Attila scn 6 player 3 (Milan - green Italians)

(load "scenario difficulty DE")
(load "scenario resign")
(load "scenario upgrades DE")
(load "scenario market")

; RESIGNING
(defrule
	(or
		(and
			(event-detected trigger 3)
			(and
				(building-type-count wonder less-than 1)
				(building-type-count town-center less-than 1)
			)
		)
		(and
			(not(event-detected trigger 3))
			(and
				(building-type-count town-center less-than 1)
				(unit-type-count villager less-than 2)
			)
		)
	)
=>
	(set-goal 1 19)
	(set-signal 2)
	(disable-self)
)

(defrule
	(true)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-maximum-town-size 25)
    (set-strategic-number sn-camp-max-distance 30)
    (set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 25)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-percent-attack-soldiers 50)
	(set-strategic-number sn-number-explore-groups 1)
	(disable-self)
)

 (defrule
	(true)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders 0)
	(set-strategic-number sn-percent-civilian-gatherers 100)
	(set-strategic-number sn-food-gatherer-percentage  100)
	(set-strategic-number sn-gold-gatherer-percentage  0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
	(set-strategic-number sn-wood-gatherer-percentage  0)
	(enable-timer 4 200)
	(disable-self)
)

(defrule
	(game-time > 180)
	(defend-soldier-count >= 15)	
=>
	(chat-local-to-self "attack")
	(attack-now)
)

; SELF- TRIB LOTS OF RESOURCES EVERY FEW MINUTES

(defrule
	(timer-triggered 4)
=>
	(chat-local-to-self "I think I need some resources")
	(cc-add-resource food 800)
	(cc-add-resource wood 800)
	(cc-add-resource gold 800)
	(cc-add-resource stone 0)
	(disable-timer 4)
	(enable-timer 4 300)
)

(defrule
	(event-detected trigger 3)
	(difficulty == easy)
=>
	(set-strategic-number sn-percent-civilian-builders 100)
	(set-strategic-number sn-percent-civilian-gatherers 0)
	(set-strategic-number sn-cap-civilian-builders 5)
	(disable-self)
)

(defrule
	(event-detected trigger 3)
	(difficulty == moderate)
=>
	(set-strategic-number sn-percent-civilian-builders 100)
	(set-strategic-number sn-percent-civilian-gatherers 0)
	(set-strategic-number sn-cap-civilian-builders 10)
	(disable-self)
)

(defrule
	(event-detected trigger 3)
	(difficulty == hard)
=>
	(set-strategic-number sn-percent-civilian-builders 100)
	(set-strategic-number sn-percent-civilian-gatherers 0)
	(set-strategic-number sn-cap-civilian-builders 20)
	(disable-self)
)

; villager count
(defrule
	(unit-type-count-total villager less-than 15)
	(can-train villager)
=>
	(train villager)
)

(defrule
	(event-detected trigger 3)
	(unit-type-count-total villager less-than 30)
	(can-train villager)
=>
	(train villager)
)

(defrule	
	(idle-farm-count <= 1)
	(game-time greater-than 300)
	(building-type-count-total farm less-than 15)
	(can-build farm)
=>
	(build farm)
)

(defrule
	(resource-found wood)
	(building-type-count-total lumber-camp < 5)
	(dropsite-min-distance wood > 5)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(chat-local-to-self "wood place")
)

(defrule
	(building-type-count-total mill less-than 1)
	(can-build mill)
=>
	(build mill)
	(chat-local-to-self "mill")
)


;MILITARY

(defrule
	(difficulty == easy)
	(unit-type-count-total knight-line < 6)
	(can-train knight-line)
=>
	(train knight-line)
	(chat-local-to-self "knight")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total knight-line < 18)
	(can-train knight-line)
=>
	(train knight-line)
	(chat-local-to-self "knight")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total trebuchet-set < 4)
	(can-train trebuchet)
=>
	(train trebuchet)
	(chat-local-to-self "tebuchet")
)

(defrule
	(unit-type-count-total mangonel-line < 3)
	(can-train mangonel-line)
=>
	(train mangonel-line)
	(chat-local-to-self "mangonel")
)

(defrule
	(difficulty == easy)
	(unit-type-count-total archer-line < 12)
	(can-train archer-line)
=>
	(train archer-line)
	(chat-local-to-self "archer")
)

(defrule
	(difficulty <= moderate)
	(unit-type-count-total archer-line < 25)
	(can-train archer-line)
=>
	(train archer-line)
	(chat-local-to-self "archer")
)

(defrule
    (cc-players-building-type-count 1 dock greater-than 0)
	(unit-type-count-total fire-ship-line < 5)
	(can-train fire-ship-line)
=>
	(train fire-ship-line)
	(chat-local-to-self " fire-ship")
)


